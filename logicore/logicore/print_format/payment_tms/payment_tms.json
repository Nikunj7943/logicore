 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Payment Voucher – {{ doc.name }}</title>\n    <style>\n        * { margin: 0; padding: 0; box-sizing: border-box; }\n        body {\n            font-family: 'Segoe UI', Arial, sans-serif;\n            font-size: 7.5pt; line-height: 1.4; color: #1a2b38;\n            background: #ffffff; padding: 10px 12px;\n            -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important;\n        }\n        .page { width: 100%; background: #ffffff; }\n\n        .header-table { width: 100%; border-collapse: collapse; border-bottom: 2.5px solid #1a3a5c; margin-bottom: 5px; }\n        .header-table td { border: none !important; padding: 6px 8px; vertical-align: middle; background: #ffffff !important; }\n        .co-logo-img { width: 38px; height: 38px; border-radius: 3px; display: block; }\n        .co-name { font-size: 14pt; font-weight: 700; color: #1a3a5c; letter-spacing: -0.5px; line-height: 1.1; }\n        .co-tagline { font-size: 6.5pt; color: #6b8da6; margin-top: 1px; }\n        .co-meta { font-size: 6.5pt; color: #2c4a62; line-height: 1.6; margin-top: 4px; }\n        .co-meta b { color: #1a3a5c; font-weight: 600; }\n        .doc-title { font-size: 15pt; font-weight: 700; color: #1a3a5c; letter-spacing: 1.5px; text-transform: uppercase; }\n        .doc-no { font-family: 'Courier New', monospace; font-size: 8pt; font-weight: 700; color: #1a3a5c; margin-top: 3px; }\n        .doc-date { font-size: 6.5pt; color: #4b6f8c; margin-top: 2px; }\n\n        .status-strip { width: 100%; border-collapse: collapse; background: #f0f4f8 !important; border-top: 1px solid #dde5ed; border-bottom: 1px solid #dde5ed; margin-bottom: 7px; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }\n        .status-strip td { padding: 4px 10px; font-size: 6.5pt; background: #f0f4f8 !important; border: none !important; }\n        .status-strip b { color: #1a3a5c; }\n\n        .pill { display: inline; padding: 2px 7px; border-radius: 20px; font-size: 6pt; font-weight: 700; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }\n        .pill-green  { background: #e6f4ec !important; color: #1a7a3c !important; border: 1px solid #aed6bc; }\n        .pill-red    { background: #fdeaea !important; color: #aa2020 !important; border: 1px solid #f0b8b8; }\n        .pill-amber  { background: #fff4e0 !important; color: #995c00 !important; border: 1px solid #f0cfa0; }\n        .pill-gray   { background: #eef2f7 !important; color: #2d4f6b !important; border: 1px solid #c8d8e6; }\n        .pill-blue   { background: #e8f2fb !important; color: #1a4d8a !important; border: 1px solid #9ac3e8; }\n        .pill-teal   { background: #e0f7f4 !important; color: #00695c !important; border: 1px solid #80cbc4; }\n        .pill-purple { background: #ede9fb !important; color: #4a2fa0 !important; border: 1px solid #b5a8e8; }\n\n        .amount-box { width: 100%; border-collapse: collapse; border: 2px solid #1a3a5c; margin-bottom: 7px; background: #f0f4f8 !important; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }\n        .amount-box td { padding: 8px 14px; border: none !important; background: #f0f4f8 !important; }\n        .amount-label { font-size: 7pt; font-weight: 600; color: #4b6f8c; text-transform: uppercase; letter-spacing: 0.5px; }\n        .amount-value { font-size: 18pt; font-weight: 700; color: #1a7a3c; font-variant-numeric: tabular-nums; line-height: 1.1; }\n        .amount-type  { font-size: 7pt; font-weight: 700; color: #1a3a5c; text-transform: uppercase; letter-spacing: 0.5px; }\n\n        .info-grid { width: 100%; border-collapse: collapse; margin-bottom: 7px; }\n        .info-grid td { border: none !important; vertical-align: top; padding: 0; }\n        .info-col   { width: 50%; padding-right: 4px !important; }\n        .info-col-r { width: 50%; padding-left: 4px !important; }\n\n        .card { width: 100%; border-collapse: collapse; border: 1px solid #dde5ed; margin-bottom: 7px; }\n        .card-head td { background: #1a3a5c !important; color: #ffffff !important; font-size: 6.5pt; font-weight: 700; letter-spacing: 0.7px; text-transform: uppercase; padding: 3px 10px; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }\n\n        .kv { width: 100%; border-collapse: collapse; }\n        .kv td { border-bottom: 1px solid #dde5ed; border-right: 1px solid #dde5ed; padding: 3px 8px; font-size: 6.5pt; vertical-align: top; background: #ffffff !important; }\n        .kv tr:last-child td { border-bottom: none !important; }\n        .kv td:last-child { border-right: none !important; }\n        .kv .k { color: #1a5fa8; font-weight: 600; width: 46%; }\n        .kv .v { color: #1a2b38; }\n        .kv .v b { font-weight: 700; color: #1a3a5c; }\n\n        .trip-card { width: 100%; border-collapse: collapse; border: 1.5px solid #1a73e8; margin-bottom: 7px; }\n        .trip-card-head td { background: #1a73e8 !important; color: #ffffff !important; font-size: 6.5pt; font-weight: 700; letter-spacing: 0.7px; text-transform: uppercase; padding: 3px 10px; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }\n        .route-arrow { font-size: 9pt; color: #1a73e8; font-weight: 700; }\n\n        .pmt-footer { background: #f0f4f8 !important; border-top: 1px solid #dde5ed; padding: 3px 10px; text-align: center; font-size: 5.8pt; color: #4b6f8c; margin-top: 7px; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }\n\n        @media print {\n            body { padding: 8px 10px; background: #fff; }\n            * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }\n        }\n    </style>\n</head>\n<body>\n<div class=\"page\">\n\n{% set company_doc = frappe.get_doc(\"Company\", doc.company) if doc.company and frappe.db.exists(\"Company\", doc.company) else None %}\n{% set co_name = company_doc.company_name if company_doc else (doc.company or \"Company\") %}\n{% if company_doc %}\n    {% set addr_list = frappe.get_list(\"Address\", filters={\"link_name\": company_doc.name, \"link_doctype\": \"Company\"}, limit=1) %}\n    {% set co_addr = frappe.get_doc(\"Address\", addr_list[0].name) if addr_list else None %}\n{% else %}\n    {% set co_addr = None %}\n{% endif %}\n\n{# -- Type-based visibility flags (mirrors form depends_on exactly) -- #}\n{% set vendor_types    = ['Loading/Unloading', 'Extra Expense', 'Office/Other Expense'] %}\n{% set employee_types  = ['Employee LR Money', 'Employee Advance'] %}\n{% set driver_types    = ['Driver Advance', 'Driver Trip Expense'] %}\n{% set account_types   = ['Office/Other Expense', 'Employee Advance', 'Driver Advance', 'Driver Trip Expense'] %}\n{% set ref_types       = ['Driver Advance', 'Employee Advance', 'Driver Trip Expense', 'Office/Other Expense'] %}\n{% set no_trip_types   = ['Office/Other Expense', 'Employee Advance', 'Driver Advance', 'Driver Trip Expense'] %}\n{% set show_trip       = doc.trip_no and doc.type not in no_trip_types %}\n{% set show_ref_no     = doc.mode_of_payment in ['Bank Transfer', 'Cheque', 'UPI'] %}\n{% set show_ref_date   = doc.mode_of_payment in ['Bank Transfer', 'Cheque'] %}\n{% set show_upi        = doc.mode_of_payment == 'UPI' %}\n\n<!-- HEADER -->\n<table class=\"header-table\">\n    <tr>\n        <td style=\"padding:6px 8px; vertical-align:middle; background:#ffffff !important;\">\n            <table style=\"border-collapse:collapse; width:100%;\">\n                <tr>\n                    <td style=\"border:none !important; padding:0 8px 0 0; vertical-align:middle; width:46px; background:#ffffff !important;\">\n                        <img src=\"/files/delivery-truck.png\" onerror=\"this.style.display='none';\" class=\"co-logo-img\" alt=\"logo\">\n                    </td>\n                    <td style=\"border:none !important; padding:0; vertical-align:middle; background:#ffffff !important;\">\n                        <div class=\"co-name\">{{ co_name }}</div>\n                        <div class=\"co-tagline\">Your Logistics Partner</div>\n                    </td>\n                </tr>\n            </table>\n            <div class=\"co-meta\" style=\"margin-top:4px;\">\n                {% if co_addr %}\n                    <b>Addr:</b> {{ co_addr.address_line1 or '' }}{% if co_addr.address_line2 %}, {{ co_addr.address_line2 }}{% endif %}{% if co_addr.city %}, {{ co_addr.city }}{% endif %}{% if co_addr.state %}, {{ co_addr.state }}{% endif %}{% if co_addr.pincode %} – {{ co_addr.pincode }}{% endif %}<br>\n                    {% if co_addr.phone %}<b>Tel:</b> {{ co_addr.phone }}&nbsp;&nbsp;{% endif %}\n                    {% if co_addr.email_id %}<b>Email:</b> {{ co_addr.email_id }}{% endif %}\n                {% endif %}\n                {% if company_doc %}\n                    &nbsp;&nbsp;<b>GSTIN:</b> {{ company_doc.gstin or '—' }}&nbsp;&nbsp;<b>PAN:</b> {{ company_doc.pan or '—' }}\n                {% endif %}\n            </div>\n        </td>\n        <td style=\"width:180px; padding:6px 8px; vertical-align:middle; text-align:right; background:#ffffff !important;\">\n            <div class=\"doc-title\">Payment Voucher</div>\n            <div class=\"doc-no\">{{ doc.name }}</div>\n            <div class=\"doc-date\">Date: {{ frappe.format_date(doc.date) if doc.date else '—' }}</div>\n            <div style=\"margin-top:4px;\">\n                {% if doc.status == 'Paid' %}<span class=\"pill pill-green\">Paid</span>\n                {% elif doc.status == 'Cancelled' %}<span class=\"pill pill-red\">Cancelled</span>\n                {% else %}<span class=\"pill pill-amber\">Draft</span>{% endif %}\n            </div>\n        </td>\n    </tr>\n</table>\n\n<!-- STATUS STRIP -->\n<table class=\"status-strip\">\n    <tr>\n        <td><b>Payment Type:</b> {{ doc.type or '—' }}&nbsp;&nbsp;&nbsp;<b>Mode:</b> {{ doc.mode_of_payment or '—' }}</td>\n        <td style=\"text-align:right;\"><b>Generated:</b> {{ frappe.utils.now_datetime().strftime('%d-%b-%Y %H:%M') }}</td>\n    </tr>\n</table>\n\n<!-- AMOUNT HIGHLIGHT BOX -->\n<table class=\"amount-box\">\n    <tr>\n        <td style=\"width:60%;\">\n            <div class=\"amount-label\">Payment Amount</div>\n            <div class=\"amount-value\">{{ frappe.utils.fmt_money(doc.amount or 0, currency='INR') }}</div>\n        </td>\n        <td style=\"text-align:right; border-left:1px solid #c8d8e8 !important;\">\n            <div class=\"amount-type\">{{ doc.type or '—' }}</div>\n            <div style=\"margin-top:5px;\">\n                {% if doc.mode_of_payment == 'Bank Transfer' %}<span class=\"pill pill-blue\">Bank Transfer</span>\n                {% elif doc.mode_of_payment == 'Cheque' %}<span class=\"pill pill-gray\">Cheque</span>\n                {% elif doc.mode_of_payment == 'UPI' %}<span class=\"pill pill-teal\">UPI</span>\n                {% elif doc.mode_of_payment == 'Cash' %}<span class=\"pill pill-amber\">Cash</span>\n                {% else %}{{ doc.mode_of_payment or '—' }}{% endif %}\n            </div>\n        </td>\n    </tr>\n</table>\n\n<!-- TWO-COLUMN INFO GRID -->\n<table class=\"info-grid\">\n    <tr>\n        <!-- PAYEE DETAILS (fields shown based on payment type) -->\n        <td class=\"info-col\">\n            <table class=\"card\">\n                <tr><td class=\"card-head\">Payee Details</td></tr>\n                <tr><td style=\"padding:0 !important; background:#ffffff !important;\">\n                    <table class=\"kv\">\n                        {% if doc.type in vendor_types and doc.vendor_supplier %}\n                        <tr><td class=\"k\">Vendor / Supplier</td><td class=\"v\"><b>{{ doc.vendor_supplier }}</b></td></tr>\n                        {% endif %}\n                        {% if doc.type in employee_types and doc.employee %}\n                        <tr><td class=\"k\">Employee</td><td class=\"v\"><b>{{ doc.employee }}</b></td></tr>\n                        {% endif %}\n                        {% if doc.type in driver_types and doc.driver %}\n                        <tr><td class=\"k\">Driver</td><td class=\"v\"><b>{{ doc.driver }}</b></td></tr>\n                        {% endif %}\n                        {% if doc.type in account_types and doc.select_account %}\n                        <tr><td class=\"k\">Account</td><td class=\"v\">{{ frappe.db.get_value(\"Account Head\", doc.select_account, \"name1\") or doc.select_account }}</td></tr>\n                        {% endif %}\n                        {% if doc.type in ref_types and doc.payment_reference %}\n                        <tr><td class=\"k\">Payment Reference</td><td class=\"v\">{{ doc.payment_reference }}</td></tr>\n                        {% endif %}\n                        {% if doc.remarks %}\n                        <tr><td class=\"k\">Remarks</td><td class=\"v\">{{ doc.remarks }}</td></tr>\n                        {% endif %}\n                    </table>\n                </td></tr>\n            </table>\n        </td>\n        <!-- PAYMENT DETAILS (fields shown based on mode of payment) -->\n        <td class=\"info-col-r\">\n            <table class=\"card\">\n                <tr><td class=\"card-head\">Payment Details</td></tr>\n                <tr><td style=\"padding:0 !important; background:#ffffff !important;\">\n                    <table class=\"kv\">\n                        <tr><td class=\"k\">Payment No</td><td class=\"v\"><b>{{ doc.name }}</b></td></tr>\n                        <tr><td class=\"k\">Payment Date</td><td class=\"v\">{{ frappe.format_date(doc.date) if doc.date else '—' }}</td></tr>\n                        <tr><td class=\"k\">Status</td><td class=\"v\">\n                            {% if doc.status == 'Paid' %}<span class=\"pill pill-green\">Paid</span>\n                            {% elif doc.status == 'Cancelled' %}<span class=\"pill pill-red\">Cancelled</span>\n                            {% else %}<span class=\"pill pill-amber\">Draft</span>{% endif %}\n                        </td></tr>\n                        {% if doc.paid_from_account %}\n                        <tr><td class=\"k\">Paid From Account</td><td class=\"v\">{{ frappe.db.get_value(\"Account Head\", doc.paid_from_account, \"name1\") or doc.paid_from_account }}</td></tr>\n                        {% endif %}\n                        {% if show_ref_no and doc.reference_no %}\n                        <tr><td class=\"k\">Reference / UTR No</td><td class=\"v\"><b>{{ doc.reference_no }}</b></td></tr>\n                        {% endif %}\n                        {% if show_ref_date and doc.reference_date %}\n                        <tr><td class=\"k\">Reference Date</td><td class=\"v\">{{ frappe.format_date(doc.reference_date) if doc.reference_date else '—' }}</td></tr>\n                        {% endif %}\n                        {% if show_upi and doc.upi_id %}\n                        <tr><td class=\"k\">UPI ID</td><td class=\"v\">{{ doc.upi_id }}</td></tr>\n                        {% endif %}\n                    </table>\n                </td></tr>\n            </table>\n        </td>\n    </tr>\n</table>\n\n<!-- TRIP REFERENCE — only for trip-based payment types -->\n{% if show_trip %}\n<table class=\"trip-card\">\n    <tr><td class=\"trip-card-head\">Trip Reference</td></tr>\n    <tr><td style=\"padding:0 !important; background:#ffffff !important;\">\n        <table class=\"kv\">\n            <tr>\n                <td class=\"k\" style=\"width:20%;\">Trip No</td>\n                <td class=\"v\" style=\"width:30%;\"><b>{{ doc.trip_no }}</b></td>\n                <td class=\"k\" style=\"width:20%;\">TCN / Trip No</td>\n                <td class=\"v\" style=\"width:30%;\"><b>{{ doc.trip_tcn_no or '—' }}</b></td>\n            </tr>\n            <tr>\n                <td class=\"k\">Trip Date</td>\n                <td class=\"v\">{{ frappe.format_date(doc.trip_date) if doc.trip_date else '—' }}</td>\n                <td class=\"k\">Trip Type</td>\n                <td class=\"v\">{{ doc.trip_type or '—' }}</td>\n            </tr>\n            {% if doc.trip_origin or doc.trip_destination %}\n            <tr>\n                <td class=\"k\">Route</td>\n                <td class=\"v\" colspan=\"3\">\n                    <b>{{ doc.trip_origin or '—' }}</b>\n                    <span class=\"route-arrow\">&nbsp;→&nbsp;</span>\n                    <b>{{ doc.trip_destination or '—' }}</b>\n                    {% if doc.trip_vehicle_type %}&nbsp;&nbsp;<span style=\"color:#4b6f8c;\">| {{ doc.trip_vehicle_type }}</span>{% endif %}\n                </td>\n            </tr>\n            {% endif %}\n        </table>\n    </td></tr>\n</table>\n{% endif %}\n\n<!-- FOOTER -->\n<div class=\"pmt-footer\">\n    System-generated Payment Voucher &nbsp;|&nbsp; {{ co_name }}\n    &nbsp;|&nbsp; Payment No: <b>{{ doc.name }}</b>\n    &nbsp;|&nbsp; Type: <b>{{ doc.type or '—' }}</b>\n    &nbsp;|&nbsp; Amount: <b>{{ frappe.utils.fmt_money(doc.amount or 0, currency='INR') }}</b>\n    &nbsp;|&nbsp; Generated: {{ frappe.utils.now_datetime().strftime('%d-%b-%Y %I:%M %p') }}\n    &nbsp;|&nbsp; This is a computer-generated document.\n</div>\n\n</div>\n</body>\n</html>",
