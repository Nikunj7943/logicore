{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-06-05 10:00:00.000000",
 "css": "",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Receipt",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Receipt – {{ doc.name }}</title>\n    <style>\n        * { margin: 0; padding: 0; box-sizing: border-box; }\n\n        body {\n            font-family: 'Segoe UI', Arial, sans-serif;\n            font-size: 7pt;\n            line-height: 1.3;\n            color: #1a2b38;\n            background: #ffffff;\n            padding: 8px 10px;\n            -webkit-print-color-adjust: exact !important;\n            print-color-adjust: exact !important;\n        }\n\n        .page { width: 100%; background: #ffffff; }\n\n        /* HEADER */\n        .header-table { width: 100%; border-collapse: collapse; border-bottom: 2.5px solid #0d2e4e; margin-bottom: 4px; }\n        .header-table td { border: none !important; padding: 6px 8px; vertical-align: middle; background: #ffffff !important; }\n        .co-logo-img { width: 36px; height: 36px; border-radius: 3px; display: block; }\n        .co-name { font-size: 14pt; font-weight: 700; color: #0d2e4e; letter-spacing: -0.5px; line-height: 1.1; }\n        .co-tagline { font-size: 6.5pt; color: #6b8da6; margin-top: 1px; }\n        .co-meta { font-size: 6.5pt; color: #2c4a62; line-height: 1.6; margin-top: 4px; }\n        .co-meta b { color: #0d2e4e; font-weight: 600; }\n        .doc-title-block { text-align: right; }\n        .doc-title { font-size: 16pt; font-weight: 700; color: #0d2e4e; letter-spacing: 2px; text-transform: uppercase; }\n        .doc-no { font-family: 'Courier New', monospace; font-size: 8pt; font-weight: 700; color: #0d2e4e; margin-top: 3px; }\n        .doc-date { font-size: 6.5pt; color: #4b6f8c; margin-top: 2px; }\n\n        /* STATUS STRIP */\n        .status-strip { width: 100%; border-collapse: collapse; background: #f4f7fa !important; border-top: 1px solid #dde5ed; border-bottom: 1px solid #dde5ed; margin-bottom: 6px; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }\n        .status-strip td { padding: 3px 8px; font-size: 6.5pt; background: #f4f7fa !important; border: none !important; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }\n        .status-strip b { color: #0d2e4e; }\n\n        /* PILLS */\n        .pill { display: inline; padding: 1px 6px; border-radius: 20px; font-size: 6pt; font-weight: 700; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }\n        .pill-green { background: #e6f4ec !important; color: #1a7a3c !important; border: 1px solid #aed6bc; }\n        .pill-red   { background: #fdeaea !important; color: #aa2020 !important; border: 1px solid #f0b8b8; }\n        .pill-amber { background: #fff4e0 !important; color: #995c00 !important; border: 1px solid #f0cfa0; }\n        .pill-gray  { background: #eef2f7 !important; color: #2d4f6b !important; border: 1px solid #c8d8e6; }\n        .pill-blue  { background: #e8f2fb !important; color: #1a4d8a !important; border: 1px solid #9ac3e8; }\n\n        /* INFO GRID */\n        .info-grid { width: 100%; border-collapse: collapse; margin-bottom: 6px; }\n        .info-grid td { border: none !important; vertical-align: top; padding: 0; }\n        .info-col { width: 50%; padding-right: 4px !important; }\n        .info-col-r { width: 50%; padding-left: 4px !important; }\n\n        /* CARD */\n        .card { width: 100%; border-collapse: collapse; border: 1px solid #dde5ed; margin-bottom: 6px; }\n        .card-head td {\n            background: #0d2e4e !important; color: #ffffff !important;\n            font-size: 6.5pt; font-weight: 700; letter-spacing: 0.7px; text-transform: uppercase;\n            padding: 3px 8px; text-align: left;\n            -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important;\n        }\n\n        /* KV */\n        .kv { width: 100%; border-collapse: collapse; }\n        .kv td { border-bottom: 1px solid #dde5ed; border-right: 1px solid #dde5ed; padding: 3px 7px; font-size: 6.5pt; vertical-align: top; background: #ffffff !important; }\n        .kv tr:last-child td { border-bottom: none !important; }\n        .kv td:last-child { border-right: none !important; }\n        .kv .k { color: #1a6faa; font-weight: 600; width: 44%; }\n        .kv .v { color: #1a2b38; }\n        .kv .v b { font-weight: 700; color: #0d2e4e; }\n\n        /* TRIPS TABLE */\n        .trips-table { width: 100%; border-collapse: collapse; border: 1px solid #dde5ed; margin-bottom: 6px; font-size: 6pt; }\n        .trips-table thead tr th {\n            background: #0d2e4e !important; color: #ffffff !important;\n            padding: 3px 5px; text-align: center;\n            font-size: 5.8pt; font-weight: 700; letter-spacing: 0.4px; text-transform: uppercase;\n            border-right: 1px solid #1e4a72;\n            -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important;\n        }\n        .trips-table thead tr th:last-child { border-right: none !important; }\n        .trips-table tbody tr td {\n            padding: 2.5px 5px; border-bottom: 1px solid #dde5ed; border-right: 1px solid #dde5ed;\n            vertical-align: middle; color: #1a2b38; background: #ffffff !important;\n        }\n        .trips-table tbody tr td:last-child { border-right: none !important; }\n        .trips-table tbody tr:last-child td { border-bottom: none !important; }\n        .trips-table tbody tr:nth-child(even) td { background: #f8fafc !important; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }\n        .trips-table .num { text-align: right; font-variant-numeric: tabular-nums; }\n        .trips-table .cen { text-align: center; }\n        .trips-table tfoot tr td {\n            background: #e8f0f8 !important; color: #0d2e4e !important;\n            font-weight: 700; font-size: 6pt; padding: 3px 5px;\n            border-top: 2px solid #0d2e4e; border-right: 1px solid #c0d0e0;\n            -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important;\n        }\n        .trips-table tfoot tr td:last-child { border-right: none !important; }\n\n        /* TOTALS SUMMARY */\n        .totals-card { width: 100%; border-collapse: collapse; border: 1px solid #dde5ed; margin-bottom: 6px; }\n        .totals-card td { border-right: 1px solid #dde5ed; padding: 5px 8px; vertical-align: top; text-align: center; background: #ffffff !important; }\n        .totals-card td:last-child { border-right: none !important; }\n        .totals-card .t-label { font-size: 6pt; font-weight: 600; color: #1a6faa; text-transform: uppercase; letter-spacing: 0.3px; margin-bottom: 3px; }\n        .totals-card .t-value { font-size: 8.5pt; font-weight: 700; color: #0d2e4e; font-variant-numeric: tabular-nums; }\n        .totals-card .t-value.highlight { color: #1a7a3c; font-size: 9.5pt; }\n\n        /* FOOTER */\n        .receipt-footer { background: #f4f7fa !important; border-top: 1px solid #dde5ed; padding: 3px 8px; text-align: center; font-size: 5.8pt; color: #4a6a85; margin-top: 6px; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }\n\n        @media print {\n            body { padding: 6px 8px; background: #fff; }\n            * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }\n        }\n    </style>\n</head>\n<body>\n<div class=\"page\">\n\n{% set company_doc = frappe.get_doc(\"Company\", doc.company) if doc.company and frappe.db.exists(\"Company\", doc.company) else None %}\n{% set co_name = company_doc.company_name if company_doc else (doc.company or \"Company\") %}\n{% if company_doc %}\n    {% set addr_list = frappe.get_list(\"Address\", filters={\"link_name\": company_doc.name, \"link_doctype\": \"Company\"}, limit=1) %}\n    {% set co_addr = frappe.get_doc(\"Address\", addr_list[0].name) if addr_list else None %}\n{% else %}\n    {% set co_addr = None %}\n{% endif %}\n\n{% set cust_doc = frappe.get_doc(\"Customer\", doc.customer) if doc.customer and frappe.db.exists(\"Customer\", doc.customer) else None %}\n{% if cust_doc %}\n    {% set cust_addr_list = frappe.get_list(\"Address\", filters={\"link_name\": cust_doc.name, \"link_doctype\": \"Customer\"}, limit=1) %}\n    {% set cust_addr = frappe.get_doc(\"Address\", cust_addr_list[0].name) if cust_addr_list else None %}\n{% else %}\n    {% set cust_addr = None %}\n{% endif %}\n\n<!-- HEADER -->\n<table class=\"header-table\">\n    <tr>\n        <td style=\"padding:6px 8px; vertical-align:middle; background:#ffffff !important;\">\n            <table style=\"border-collapse:collapse; width:100%;\">\n                <tr>\n                    <td style=\"border:none !important; padding:0 8px 0 0; vertical-align:middle; width:44px; background:#ffffff !important;\">\n                        <img src=\"/files/delivery-truck.png\" onerror=\"this.style.display='none';\" class=\"co-logo-img\" alt=\"logo\">\n                    </td>\n                    <td style=\"border:none !important; padding:0; vertical-align:middle; background:#ffffff !important;\">\n                        <div class=\"co-name\">{{ co_name }}</div>\n                        <div class=\"co-tagline\">Your Logistics Partner</div>\n                    </td>\n                </tr>\n            </table>\n            <div class=\"co-meta\" style=\"margin-top:4px;\">\n                {% if co_addr %}\n                    <b>Addr:</b> {{ co_addr.address_line1 or '' }}{% if co_addr.address_line2 %}, {{ co_addr.address_line2 }}{% endif %}{% if co_addr.city %}, {{ co_addr.city }}{% endif %}{% if co_addr.state %}, {{ co_addr.state }}{% endif %}{% if co_addr.pincode %} – {{ co_addr.pincode }}{% endif %}<br>\n                    {% if co_addr.phone %}<b>Tel:</b> {{ co_addr.phone }}&nbsp;&nbsp;{% endif %}\n                    {% if co_addr.email_id %}<b>Email:</b> {{ co_addr.email_id }}{% endif %}\n                {% endif %}\n                {% if company_doc %}\n                    &nbsp;&nbsp;<b>GSTIN:</b> {{ company_doc.gstin or '—' }}&nbsp;&nbsp;<b>PAN:</b> {{ company_doc.pan or '—' }}\n                {% endif %}\n            </div>\n        </td>\n        <td style=\"width:150px; padding:6px 8px; vertical-align:middle; text-align:right; background:#ffffff !important;\">\n            <div class=\"doc-title\">Receipt</div>\n            <div class=\"doc-no\">{{ doc.name }}</div>\n            <div class=\"doc-date\">Date: {{ frappe.format_date(doc.payment_date) if doc.payment_date else '—' }}</div>\n            <div style=\"margin-top:4px;\">\n                {% if doc.docstatus == 1 %}\n                    <span class=\"pill pill-green\">Submitted</span>\n                {% elif doc.docstatus == 2 %}\n                    <span class=\"pill pill-red\">Cancelled</span>\n                {% else %}\n                    <span class=\"pill pill-amber\">Draft</span>\n                {% endif %}\n            </div>\n        </td>\n    </tr>\n</table>\n\n<!-- STATUS STRIP -->\n<table class=\"status-strip\">\n    <tr>\n        <td><b>Customer:</b> {{ doc.customer or '—' }}&nbsp;&nbsp;&nbsp;<b>Trip Type:</b> {{ doc.trip_type or '—' }}</td>\n        <td style=\"text-align:right;\"><b>Period:</b> {{ frappe.format_date(doc.from_date) if doc.from_date else '—' }} &nbsp;–&nbsp; {{ frappe.format_date(doc.to_date) if doc.to_date else '—' }}&nbsp;&nbsp;&nbsp;<b>Generated:</b> {{ frappe.utils.now_datetime().strftime('%d-%b-%Y %H:%M') }}</td>\n    </tr>\n</table>\n\n<!-- TWO-COLUMN INFO GRID -->\n<table class=\"info-grid\">\n    <tr>\n        <!-- PARTY DETAILS -->\n        <td class=\"info-col\">\n            <table class=\"card\">\n                <tr><td class=\"card-head\" colspan=\"2\">Party Details</td></tr>\n                <tr><td style=\"padding:0 !important; background:#ffffff !important;\">\n                    <table class=\"kv\">\n                        <tr><td class=\"k\">Customer</td><td class=\"v\"><b>{{ doc.customer or '—' }}</b></td></tr>\n                        {% if cust_addr %}\n                        <tr><td class=\"k\">Address</td><td class=\"v\">{{ cust_addr.address_line1 or '' }}{% if cust_addr.city %}, {{ cust_addr.city }}{% endif %}{% if cust_addr.state %}, {{ cust_addr.state }}{% endif %}</td></tr>\n                        {% endif %}\n                        {% if cust_doc and cust_doc.get('gst_category') %}\n                        <tr><td class=\"k\">GST Category</td><td class=\"v\">{{ cust_doc.gst_category or '—' }}</td></tr>\n                        {% endif %}\n                        <tr><td class=\"k\">Trip Type</td><td class=\"v\">{{ doc.trip_type or '—' }}</td></tr>\n                        <tr><td class=\"k\">Period</td><td class=\"v\">{{ frappe.format_date(doc.from_date) if doc.from_date else '—' }} to {{ frappe.format_date(doc.to_date) if doc.to_date else '—' }}</td></tr>\n                    </table>\n                </td></tr>\n            </table>\n        </td>\n        <!-- PAYMENT DETAILS -->\n        <td class=\"info-col-r\">\n            <table class=\"card\">\n                <tr><td class=\"card-head\" colspan=\"2\">Payment Details</td></tr>\n                <tr><td style=\"padding:0 !important; background:#ffffff !important;\">\n                    <table class=\"kv\">\n                        <tr><td class=\"k\">Receipt No</td><td class=\"v\"><b>{{ doc.name }}</b></td></tr>\n                        <tr><td class=\"k\">Payment Date</td><td class=\"v\">{{ frappe.format_date(doc.payment_date) if doc.payment_date else '—' }}</td></tr>\n                        <tr><td class=\"k\">Mode of Payment</td><td class=\"v\">\n                            {% if doc.mode_of_payment == 'Bank Transfer' %}<span class=\"pill pill-blue\">Bank Transfer</span>\n                            {% elif doc.mode_of_payment == 'Cheque' %}<span class=\"pill pill-gray\">Cheque</span>\n                            {% elif doc.mode_of_payment == 'UPI' %}<span class=\"pill pill-green\">UPI</span>\n                            {% elif doc.mode_of_payment == 'Cash' %}<span class=\"pill pill-amber\">Cash</span>\n                            {% else %}{{ doc.mode_of_payment or '—' }}{% endif %}\n                        </td></tr>\n                        {% if doc.reference_no %}\n                        <tr><td class=\"k\">Reference / UTR No</td><td class=\"v\"><b>{{ doc.reference_no }}</b></td></tr>\n                        {% endif %}\n                        {% if doc.reference_date %}\n                        <tr><td class=\"k\">Reference Date</td><td class=\"v\">{{ frappe.format_date(doc.reference_date) if doc.reference_date else '—' }}</td></tr>\n                        {% endif %}\n                        {% if doc.upi_id %}\n                        <tr><td class=\"k\">UPI ID</td><td class=\"v\">{{ doc.upi_id }}</td></tr>\n                        {% endif %}\n                        {% if doc.paid_from_account %}\n                        <tr><td class=\"k\">Deposit Account</td><td class=\"v\">{{ frappe.db.get_value(\"Account Head\", doc.paid_from_account, \"name1\") or doc.paid_from_account }}</td></tr>\n                        {% endif %}\n                    </table>\n                </td></tr>\n            </table>\n        </td>\n    </tr>\n</table>\n\n<!-- TRIPS TABLE -->\n<table class=\"card\" style=\"margin-bottom:4px;\">\n    <tr><td class=\"card-head\">Trip-wise Settlement Details</td></tr>\n    <tr><td style=\"padding:0 !important; background:#ffffff !important;\">\n        <table class=\"trips-table\">\n            <thead>\n                <tr>\n                    <th style=\"width:24px;\">Sr</th>\n                    <th>Trip Date</th>\n                    <th>TCN / Trip No</th>\n                    <th>LR No</th>\n                    <th>Origin</th>\n                    <th>Destination</th>\n                    <th style=\"text-align:right;\">Invoice Amt</th>\n                    <th style=\"text-align:right;\">O/S Balance</th>\n                    <th style=\"text-align:right;\">Received</th>\n                    <th style=\"text-align:right;\">Brokerage</th>\n                    <th style=\"text-align:right;\">LR Money</th>\n                    <th style=\"text-align:right;\">TDS</th>\n                    <th style=\"text-align:right;\">Net Received</th>\n                    <th>UTR No</th>\n                    <th>Remarks</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% for row in doc.trips %}\n                <tr>\n                    <td class=\"cen\">{{ loop.index }}</td>\n                    <td class=\"cen\">{{ frappe.format_date(row.trip_date) if row.trip_date else '—' }}</td>\n                    <td>{{ row.tcntrip_no or '—' }}</td>\n                    <td>{{ row.lr_no or '—' }}</td>\n                    <td>{{ row.origin_city or '—' }}</td>\n                    <td>{{ row.destination_city or '—' }}</td>\n                    <td class=\"num\">{{ frappe.utils.fmt_money(row.invoice_amount or 0, currency='INR') }}</td>\n                    <td class=\"num\">{{ frappe.utils.fmt_money(row.balance or 0, currency='INR') }}</td>\n                    <td class=\"num\"><b>{{ frappe.utils.fmt_money(row.received_amount or 0, currency='INR') }}</b></td>\n                    <td class=\"num\">{{ frappe.utils.fmt_money(row.brokerage_amount or 0, currency='INR') }}</td>\n                    <td class=\"num\">{{ frappe.utils.fmt_money(row.lr_money or 0, currency='INR') }}</td>\n                    <td class=\"num\">{{ frappe.utils.fmt_money(row.tds_amount or 0, currency='INR') }}</td>\n                    <td class=\"num\" style=\"color:#1a7a3c; font-weight:700;\">{{ frappe.utils.fmt_money(row.net_received or 0, currency='INR') }}</td>\n                    <td>{{ row.utr_no or '—' }}</td>\n                    <td>{{ row.row_remarks or '' }}</td>\n                </tr>\n                {% else %}\n                <tr><td colspan=\"15\" style=\"text-align:center; color:#6b8da6; padding:8px;\">No trips found.</td></tr>\n                {% endfor %}\n            </tbody>\n            {% if doc.trips %}\n            <tfoot>\n                <tr>\n                    <td colspan=\"6\" style=\"text-align:left; font-weight:700;\">TOTAL ({{ doc.trips | length }} Trip{{ 's' if doc.trips | length != 1 else '' }})</td>\n                    <td class=\"num\">{{ frappe.utils.fmt_money(doc.total_invoice_amount or 0, currency='INR') }}</td>\n                    <td></td>\n                    <td class=\"num\"><b>{{ frappe.utils.fmt_money((doc.trips | sum(attribute='received_amount') or 0), currency='INR') }}</b></td>\n                    <td class=\"num\">{{ frappe.utils.fmt_money(doc.total_brokerage_amount or 0, currency='INR') }}</td>\n                    <td class=\"num\">{{ frappe.utils.fmt_money(doc.total_lr_money or 0, currency='INR') }}</td>\n                    <td class=\"num\">{{ frappe.utils.fmt_money(doc.total_tds_amount or 0, currency='INR') }}</td>\n                    <td class=\"num\" style=\"color:#1a7a3c;\"><b>{{ frappe.utils.fmt_money(doc.total_received_amount or 0, currency='INR') }}</b></td>\n                    <td colspan=\"2\"></td>\n                </tr>\n            </tfoot>\n            {% endif %}\n        </table>\n    </td></tr>\n</table>\n\n<!-- TOTALS SUMMARY CARDS -->\n<table class=\"totals-card\">\n    <tr>\n        <td>\n            <div class=\"t-label\">Total Invoice Amount</div>\n            <div class=\"t-value\">{{ frappe.utils.fmt_money(doc.total_invoice_amount or 0, currency='INR') }}</div>\n        </td>\n        <td>\n            <div class=\"t-label\">Total Brokerage</div>\n            <div class=\"t-value\">{{ frappe.utils.fmt_money(doc.total_brokerage_amount or 0, currency='INR') }}</div>\n        </td>\n        <td>\n            <div class=\"t-label\">Broker LR Money</div>\n            <div class=\"t-value\">{{ frappe.utils.fmt_money(doc.total_lr_money or 0, currency='INR') }}</div>\n        </td>\n        <td>\n            <div class=\"t-label\">TDS Deducted</div>\n            <div class=\"t-value\">{{ frappe.utils.fmt_money(doc.total_tds_amount or 0, currency='INR') }}</div>\n        </td>\n        <td style=\"background:#e8f4ec !important; -webkit-print-color-adjust:exact !important; print-color-adjust:exact !important;\">\n            <div class=\"t-label\" style=\"color:#1a7a3c;\">Total Actual Received</div>\n            <div class=\"t-value highlight\">{{ frappe.utils.fmt_money(doc.total_received_amount or 0, currency='INR') }}</div>\n        </td>\n    </tr>\n</table>\n\n<!-- FOOTER -->\n<div class=\"receipt-footer\">\n    System-generated Receipt &nbsp;|&nbsp; {{ co_name }}\n    &nbsp;|&nbsp; Receipt No: <b>{{ doc.name }}</b>\n    &nbsp;|&nbsp; Customer: <b>{{ doc.customer or '—' }}</b>\n    &nbsp;|&nbsp; Generated: {{ frappe.utils.now_datetime().strftime('%d-%b-%Y %I:%M %p') }}\n    &nbsp;|&nbsp; This is a computer-generated document.\n</div>\n\n</div>\n</body>\n</html>",
