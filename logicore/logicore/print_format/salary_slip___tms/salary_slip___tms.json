 "font_size": 14,
 "html": "{# Staff Payroll Print Template - Table-Based Navy Theme #}\r\n{% set doc = doc %}\r\n{% set company = doc.company %}\r\n\r\n<!DOCTYPE html>\r\n<html>\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <title>Salary Slip - {{ doc.name }}</title>\r\n    <style>\r\n        @page {\r\n            size: A4;\r\n            margin: 0.4in;\r\n        }\r\n        body {\r\n            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\r\n            font-size: 10pt;\r\n            color: #1e2a3a;\r\n            margin: 0;\r\n            padding: 0;\r\n            background: white;\r\n        }\r\n        table {\r\n            width: 100%;\r\n            border-collapse: collapse;\r\n        }\r\n        td, th {\r\n            padding: 6px 8px;\r\n            vertical-align: top;\r\n        }\r\n        .navy-header {\r\n            background: #0a2540;\r\n            color: white;\r\n        }\r\n        .navy-bg {\r\n            background: #0a2540;\r\n            color: white;\r\n        }\r\n        .light-bg {\r\n            background: #f8fafd;\r\n        }\r\n        .border-bottom {\r\n            border-bottom: 1px solid #e2e8f0;\r\n        }\r\n        .border-dashed {\r\n            border-bottom: 1px dashed #cbd5e1;\r\n        }\r\n        .text-right {\r\n            text-align: right;\r\n        }\r\n        .text-center {\r\n            text-align: center;\r\n        }\r\n        .fw-bold {\r\n            font-weight: 700;\r\n        }\r\n        .amount {\r\n            font-family: 'Courier New', monospace;\r\n            font-weight: 600;\r\n        }\r\n        .sign-line {\r\n            border-top: 1px solid #0a2540;\r\n            width: 120px;\r\n            margin: 8px auto 4px;\r\n        }\r\n        hr {\r\n            margin: 4px 0;\r\n            border: 0;\r\n            border-top: 1px solid #e2e8f0;\r\n        }\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<!-- MAIN CONTAINER TABLE -->\r\n<table style=\"width:100%; background:white;\">\r\n    <!-- HEADER (navy) -->\r\n    <tr class=\"navy-header\">\r\n        <td style=\"padding: 12px 20px;\">\r\n            <table style=\"width:100%;\">\r\n                <tr>\r\n                    <td style=\"width:60%;\">\r\n                        <h2 style=\"margin:0; font-size:18pt;\">{{ company|upper|default('COMPANY') }}</h2>\r\n                        <p style=\"margin:2px 0 0; font-size:9pt; opacity:0.85;\">{{ doc.branch or '' }}<br>{{ doc.from_date }} to {{ doc.to_date }}</p>\r\n                    </td>\r\n                    <td style=\"text-align:right;\">\r\n                        <div style=\"font-size:16pt; font-weight:700;\">SALARY SLIP</div>\r\n                        <div style=\"font-size:8pt; opacity:0.8;\">{{ doc.name }} | {{ doc.payroll_date or frappe.utils.nowdate() }}</div>\r\n                    </td>\r\n                </tr>\r\n            </table>\r\n        </td>\r\n    </tr>\r\n\r\n    <!-- CONTENT SECTION -->\r\n    <tr>\r\n        <td style=\"padding: 16px 20px;\">\r\n            <!-- Employee Details (table) -->\r\n            <table style=\"width:100%; background:#f8fafd; border-left:4px solid #0a2540; border-radius:0; margin-bottom:18px;\">\r\n                <tr>\r\n                    <td style=\"width:50%; padding:8px 12px;\">\r\n                        <table style=\"width:100%;\">\r\n                            <tr class=\"border-dashed\"><td style=\"width:130px;\" class=\"fw-bold\">Employee ID</td><td>{{ doc.employee or '-' }}</td></tr>\r\n                            <tr class=\"border-dashed\"><td class=\"fw-bold\">Name</td><td>{{ doc.employee_name or '-' }}</td></tr>\r\n                            <tr class=\"border-dashed\"><td class=\"fw-bold\">Department</td><td>{{ doc.department or '-' }}</td></tr>\r\n                        </table>\r\n                    </td>\r\n                    <td style=\"width:50%; padding:8px 12px;\">\r\n                        <table style=\"width:100%;\">\r\n                            <tr class=\"border-dashed\"><td style=\"width:130px;\" class=\"fw-bold\">Designation</td><td>{{ doc.designation or '-' }}</td></tr>\r\n                            <tr class=\"border-dashed\"><td class=\"fw-bold\">CTC (Annual)</td><td>{{ frappe.utils.fmt_money(doc.ctc) if doc.ctc else '0.00' }}</td></tr>\r\n                            <tr class=\"border-dashed\"><td class=\"fw-bold\">Salary Structure</td><td>{{ doc.salary_structure or '-' }}</td></tr>\r\n                        </table>\r\n                    </td>\r\n                </tr>\r\n            </table>\r\n\r\n            <!-- Attendance Summary (grid as table rows) -->\r\n            <table style=\"width:100%; margin-bottom:8px;\">\r\n                <tr>\r\n                    <td colspan=\"8\" style=\"padding:0;\">\r\n                        <div style=\"background:#0a2540; color:white; padding:4px 12px; display:inline-block; font-weight:600; font-size:10pt;\">\ud83d\udcca ATTENDANCE</div>\r\n                    </td>\r\n                </tr>\r\n                <tr>\r\n                    <td style=\"width:12.5%; background:#f8fafd; border:1px solid #e2e8f0; text-align:center; padding:6px;\">\r\n                        <div style=\"font-size:8pt; text-transform:uppercase;\">Working Days</div>\r\n                        <div style=\"font-size:16pt; font-weight:800; color:#0a2540;\">{{ doc.working_days or 0 }}</div>\r\n                    </td>\r\n                    <td style=\"width:12.5%; background:#f8fafd; border:1px solid #e2e8f0; text-align:center; padding:6px;\">\r\n                        <div style=\"font-size:8pt; text-transform:uppercase;\">Present</div>\r\n                        <div style=\"font-size:16pt; font-weight:800; color:#0a2540;\">{{ doc.present_days or 0 }}</div>\r\n                    </td>\r\n                    <td style=\"width:12.5%; background:#f8fafd; border:1px solid #e2e8f0; text-align:center; padding:6px;\">\r\n                        <div style=\"font-size:8pt; text-transform:uppercase;\">Leave (Paid)</div>\r\n                        <div style=\"font-size:16pt; font-weight:800; color:#0a2540;\">{{ doc.leave_with_pay or 0 }}</div>\r\n                    </td>\r\n                    <td style=\"width:12.5%; background:#f8fafd; border:1px solid #e2e8f0; text-align:center; padding:6px;\">\r\n                        <div style=\"font-size:8pt; text-transform:uppercase;\">Leave (Unpaid)</div>\r\n                        <div style=\"font-size:16pt; font-weight:800; color:#0a2540;\">{{ doc.leave_without_pay or 0 }}</div>\r\n                    </td>\r\n                    <td style=\"width:12.5%; background:#f8fafd; border:1px solid #e2e8f0; text-align:center; padding:6px;\">\r\n                        <div style=\"font-size:8pt; text-transform:uppercase;\">Worked Days</div>\r\n                        <div style=\"font-size:16pt; font-weight:800; color:#0a2540;\">{{ doc.worked_days or 0 }}</div>\r\n                    </td>\r\n                    <td style=\"width:12.5%; background:#f8fafd; border:1px solid #e2e8f0; text-align:center; padding:6px;\">\r\n                        <div style=\"font-size:8pt; text-transform:uppercase;\">Absent</div>\r\n                        <div style=\"font-size:16pt; font-weight:800; color:#0a2540;\">{{ doc.absent_days or 0 }}</div>\r\n                    </td>\r\n                    <td style=\"width:12.5%; background:#f8fafd; border:1px solid #e2e8f0; text-align:center; padding:6px;\">\r\n                        <div style=\"font-size:8pt; text-transform:uppercase;\">Total Days</div>\r\n                        <div style=\"font-size:16pt; font-weight:800; color:#0a2540;\">{{ doc.total_days or 0 }}</div>\r\n                    </td>\r\n                    <td style=\"width:12.5%; background:#f8fafd; border:1px solid #e2e8f0; text-align:center; padding:6px;\">\r\n                        <div style=\"font-size:8pt; text-transform:uppercase;\">Salary/Day</div>\r\n                        <div style=\"font-size:16pt; font-weight:800; color:#0a2540;\">{{ frappe.utils.fmt_money(doc.salary_per_day) if doc.salary_per_day else '0' }}</div>\r\n                    </td>\r\n                </tr>\r\n            </table>\r\n\r\n            <!-- Earnings & Deductions side by side -->\r\n            <table style=\"width:100%; margin:10px 0;\">\r\n                <tr>\r\n                    <!-- EARNINGS TABLE -->\r\n                    <td style=\"width:50%; vertical-align:top; padding-right:10px;\">\r\n                        <div style=\"background:#0a2540; color:white; padding:4px 12px; display:inline-block; font-weight:600; font-size:10pt;\">\ud83d\udcc8 EARNINGS</div>\r\n                        <table style=\"width:100%; border-collapse:collapse; margin-top:6px;\">\r\n                            <thead>\r\n                                <tr style=\"background:#eef3fc;\">\r\n                                    <th style=\"text-align:left; border-bottom:2px solid #0a2540; padding:6px;\">Component</th>\r\n                                    <th style=\"text-align:right; border-bottom:2px solid #0a2540; padding:6px;\">Amount (\u20b9)</th>\r\n                                </tr>\r\n                            </thead>\r\n                            <tbody>\r\n                                {% if doc.earnings_table and doc.earnings_table|length > 0 %}\r\n                                    {% for row in doc.earnings_table %}\r\n                                    <tr style=\"border-bottom:1px solid #edf2f7;\">\r\n                                        <td style=\"padding:5px;\">{{ row.salary_component or '' }}</td>\r\n                                        <td class=\"text-right amount\">{{ frappe.utils.fmt_money(row.amount) if row.amount else '0.00' }}</td>\r\n                                    </tr>\r\n                                    {% endfor %}\r\n                                {% else %}\r\n                                    <tr><td colspan=\"2\" style=\"text-align:center; padding:10px;\">\u2014 No entries \u2014</td></tr>\r\n                                {% endif %}\r\n                            </tbody>\r\n                        </table>\r\n                    </td>\r\n                    <!-- DEDUCTIONS TABLE -->\r\n                    <td style=\"width:50%; vertical-align:top; padding-left:10px;\">\r\n                        <div style=\"background:#0a2540; color:white; padding:4px 12px; display:inline-block; font-weight:600; font-size:10pt;\">\ud83d\udcc9 DEDUCTIONS</div>\r\n                        <table style=\"width:100%; border-collapse:collapse; margin-top:6px;\">\r\n                            <thead>\r\n                                <tr style=\"background:#eef3fc;\">\r\n                                    <th style=\"text-align:left; border-bottom:2px solid #0a2540; padding:6px;\">Component</th>\r\n                                    <th style=\"text-align:right; border-bottom:2px solid #0a2540; padding:6px;\">Amount (\u20b9)</th>\r\n                                </tr>\r\n                            </thead>\r\n                            <tbody>\r\n                                {% if doc.deductions_table and doc.deductions_table|length > 0 %}\r\n                                    {% for row in doc.deductions_table %}\r\n                                    <tr style=\"border-bottom:1px solid #edf2f7;\">\r\n                                        <td style=\"padding:5px;\">{{ row.salary_component or '' }}</td>\r\n                                        <td class=\"text-right amount\">{{ frappe.utils.fmt_money(row.amount) if row.amount else '0.00' }}</td>\r\n                                    </tr>\r\n                                    {% endfor %}\r\n                                {% else %}\r\n                                    <tr><td colspan=\"2\" style=\"text-align:center; padding:10px;\">\u2014 No deductions \u2014</td></tr>\r\n                                {% endif %}\r\n                            </tbody>\r\n                        </table>\r\n                    </td>\r\n                </tr>\r\n            </table>\r\n\r\n            <!-- Totals (right aligned) -->\r\n            <table style=\"width:100%; margin:6px 0;\">\r\n                <tr>\r\n                    <td style=\"text-align:right;\">\r\n                        <table style=\"width:280px; background:#f8fafd; border:1px solid #e2e8f0; margin-left:auto;\">\r\n                            <tr><td style=\"padding:5px 12px;\"><span class=\"fw-bold\">Total Earnings (A)</span><span style=\"float:right;\">{{ frappe.utils.fmt_money(doc.total_earnings) if doc.total_earnings else '0.00' }}</span></td></tr>\r\n                            <tr style=\"border-top:1px dashed #dce5ef;\"><td style=\"padding:5px 12px;\"><span class=\"fw-bold\">Total Deductions (B)</span><span style=\"float:right;\">{{ frappe.utils.fmt_money(doc.total_deductions) if doc.total_deductions else '0.00' }}</span></td></tr>\r\n                        </table>\r\n                    </td>\r\n                </tr>\r\n            </table>\r\n\r\n            <!-- Net Salary (highlight) -->\r\n            <table style=\"width:100%; background:linear-gradient(135deg, #0a2540, #1a4a6f); color:white; margin:12px 0;\">\r\n                <tr>\r\n                    <td style=\"padding:10px 20px; font-weight:700; font-size:11pt;\">\ud83d\udcb0 NET PAYABLE (A - B)</td>\r\n                    <td style=\"padding:10px 20px; text-align:right; font-weight:800; font-size:20pt;\">{{ frappe.utils.fmt_money(doc.net_salary) if doc.net_salary else '0.00' }}</td>\r\n                </tr>\r\n            </table>\r\n\r\n            <!-- Payment & Approval (side by side tables) -->\r\n            <table style=\"width:100%; margin:10px 0;\">\r\n                <tr>\r\n                    <td style=\"width:50%; vertical-align:top; padding-right:10px;\">\r\n                        <table style=\"width:100%; background:#f8fafd; border:1px solid #e2e8f0;\">\r\n                            <tr><td style=\"padding:8px 12px; border-left:3px solid #0a2540;\" class=\"fw-bold\">\ud83d\udcb3 Payment</td></tr>\r\n                            <tr><td style=\"padding:5px 12px;\"><span class=\"fw-bold\">Mode</span> <span style=\"float:right;\">{{ doc.payment_mode or 'Bank Transfer' }}</span></td></tr>\r\n                            <tr><td style=\"padding:5px 12px; border-top:1px dashed #e2e8f0;\"><span class=\"fw-bold\">Bank Account</span> <span style=\"float:right;\">{{ doc.bank_account or '-' }}</span></td></tr>\r\n                            <tr><td style=\"padding:5px 12px; border-top:1px dashed #e2e8f0;\"><span class=\"fw-bold\">Payment Date</span> <span style=\"float:right;\">{{ doc.payment_date or '-' }}</span></td></tr>\r\n                            <tr><td style=\"padding:5px 12px; border-top:1px dashed #e2e8f0;\"><span class=\"fw-bold\">Transaction ID</span> <span style=\"float:right;\">{{ doc.transaction_id or '-' }}</span></td></tr>\r\n                        </table>\r\n                    </td>\r\n                    <td style=\"width:50%; vertical-align:top; padding-left:10px;\">\r\n                        <table style=\"width:100%; background:#f8fafd; border:1px solid #e2e8f0;\">\r\n                            <tr><td style=\"padding:8px 12px; border-left:3px solid #0a2540;\" class=\"fw-bold\">\u2713 Approval</td></tr>\r\n                            <tr><td style=\"padding:5px 12px;\"><span class=\"fw-bold\">Status</span> <span style=\"float:right;\">{{ doc.status or 'Draft' }}</span></td></tr>\r\n                            <tr><td style=\"padding:5px 12px; border-top:1px dashed #e2e8f0;\"><span class=\"fw-bold\">Approved By</span> <span style=\"float:right;\">{{ doc.approved_by or '-' }}</span></td></tr>\r\n                            <tr><td style=\"padding:5px 12px; border-top:1px dashed #e2e8f0;\"><span class=\"fw-bold\">Approved Date</span> <span style=\"float:right;\">{{ doc.approved_date or '-' }}</span></td></tr>\r\n                            <tr><td style=\"padding:5px 12px; border-top:1px dashed #e2e8f0;\"><span class=\"fw-bold\">Remarks</span> <span style=\"float:right;\">{{ doc.remarks or '-' }}</span></td></tr>\r\n                        </table>\r\n                    </td>\r\n                </tr>\r\n            </table>\r\n\r\n            <!-- Footer signatures (table) -->\r\n            <table style=\"width:100%; margin-top:20px; border-top:1px solid #e2e8f0; padding-top:12px;\">\r\n                <tr>\r\n                    <td style=\"text-align:center; width:33%;\">\r\n                        <div class=\"sign-line\"></div>\r\n                        Employee Signature\r\n                    </td>\r\n                    <td style=\"text-align:center; width:34%;\">\r\n                        <div class=\"sign-line\"></div>\r\n                        HR / Payroll Manager\r\n                    </td>\r\n                    <td style=\"text-align:center; width:33%;\">\r\n                        <div class=\"sign-line\"></div>\r\n                        Authorised Signatory\r\n                    </td>\r\n                </tr>\r\n            </table>\r\n\r\n        </td>\r\n    </tr>\r\n</table>\r\n\r\n</body>\r\n</html>",
