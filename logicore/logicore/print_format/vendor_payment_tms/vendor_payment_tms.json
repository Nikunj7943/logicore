 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Vendor Payment \u2013 {{ doc.name }}</title>\n   <style>\n*{\n    margin:0;\n    padding:0;\n    box-sizing:border-box;\n}\n\nbody{\n    font-family:Arial, Helvetica, sans-serif;\n    font-size:9px;\n    color:#000;\n    background:#fff;\n    padding:8px;\n}\n\n.page{\n    width:100%;\n}\n\ntable{\n    width:100%;\n    border-collapse:collapse;\n}\n\n.header-table td { border:none !important; }\n.status-strip,\n.card,\n.trips-table,\n.totals-card{\n    border:1px solid #000;\n    margin-bottom:8px;\n}\n\n.header-table td,\n.status-strip td,\n.card td,\n.trips-table td,\n.trips-table th,\n.totals-card td{\n    border:1px solid #000;\n    padding:4px;\n    color:#000;\n}\n\n.co-logo-img{\n    width:45px;\n    height:45px;\n    object-fit:contain;\n}\n\n.co-name{\n    font-size:16px;\n    font-weight:bold;\n    color:#000;\n}\n\n.co-tagline{\n    font-size:8px;\n    color:#000;\n}\n\n.co-meta{\n    font-size:8px;\n    color:#000;\n    line-height:1.4;\n}\n\n.doc-title{\n    font-size:18px;\n    font-weight:bold;\n    color:#000;\n    text-transform:uppercase;\n}\n\n.doc-no{\n    font-size:10px;\n    font-weight:bold;\n    color:#000;\n}\n\n.doc-date{\n    font-size:8px;\n    color:#000;\n}\n\n.status-strip{\n    background:#fff;\n}\n\n.status-strip td{\n    font-size:8px;\n}\n\n.info-grid{\n    width:100%;\n    border-collapse:collapse;\n}\n\n.info-grid td{\n    vertical-align:top;\n    border:none !important;\n    padding:0;\n}\n\n.info-col{\n    width:50%;\n    padding-right:4px !important;\n}\n\n.info-col-r{\n    width:50%;\n    padding-left:4px !important;\n}\n\n.card-head{\n    background:#fff !important;\n    color:#000 !important;\n    font-weight:bold;\n    text-transform:uppercase;\n    text-align:left;\n    border-bottom:1px solid #000 !important;\n}\n\n.card-head td{\n    background:#fff !important;\n    color:#000 !important;\n    font-weight:bold;\n}\n\n.kv{\n    width:100%;\n    border-collapse:collapse;\n}\n\n.kv td{\n    border:1px solid #000;\n    padding:4px;\n}\n\n.k{\n    font-weight:bold;\n    width:35%;\n    color:#000;\n}\n\n.v{\n    color:#000;\n}\n\n.trips-table{\n    font-size:8px;\n}\n\n.trips-table th{\n    background:#fff !important;\n    color:#000 !important;\n    text-align:center;\n    font-weight:bold;\n}\n\n.trips-table td{\n    background:#fff !important;\n    color:#000 !important;\n}\n\n.trips-table tbody tr:nth-child(even) td{\n    background:#fff !important;\n}\n\n.trips-table tfoot td{\n    font-weight:bold;\n    background:#fff !important;\n    color:#000 !important;\n}\n\n.num{\n    text-align:right;\n}\n\n.cen{\n    text-align:center;\n}\n\n.totals-card td{\n    text-align:center;\n    background:#fff !important;\n}\n\n.t-label{\n    font-size:9px;\n    font-weight:bold;\n    color:#000;\n    margin-bottom:2px;\n}\n\n.t-value{\n    font-size:12px;\n    font-weight:bold;\n    color:#000;\n}\n\n.highlight{\n    color:#000 !important;\n}\n\n.pill,\n.pill-green,\n.pill-red,\n.pill-amber,\n.pill-blue,\n.pill-gray,\n.pill-purple{\n    display:inline-block;\n    padding:2px 6px;\n    border:1px solid #000;\n    background:#fff !important;\n    color:#000 !important;\n    border-radius:0;\n    font-size:8px;\n    font-weight:bold;\n}\n\n.vp-footer{\n    border:1px solid #000;\n    padding:5px;\n    text-align:center;\n    font-size:8px;\n    color:#000;\n    margin-top:8px;\n}\n\n@media print{\n    body{\n        padding:5px;\n    }\n\n    *{\n        color:#000 !important;\n        background:#fff !important;\n        box-shadow:none !important;\n    }\n}\n</style>\n</head>\n<body>\n<div class=\"page\">\n\n{% set company_doc = frappe.get_doc(\"Company\", doc.company) if doc.company and frappe.db.exists(\"Company\", doc.company) else None %}\n{% set co_name = company_doc.company_name if company_doc else (doc.company or \"Company\") %}\n{% if company_doc %}\n    {% set addr_list = frappe.get_list(\"Address\", filters={\"link_name\": company_doc.name, \"link_doctype\": \"Company\"}, limit=1) %}\n    {% set co_addr = frappe.get_doc(\"Address\", addr_list[0].name) if addr_list else None %}\n{% else %}\n    {% set co_addr = None %}\n{% endif %}\n\n{% set vendor_doc = frappe.get_doc(\"Supplier\", doc.vendor) if doc.vendor and frappe.db.exists(\"Supplier\", doc.vendor) else None %}\n{% if vendor_doc %}\n    {% set vend_addr_list = frappe.get_list(\"Address\", filters={\"link_name\": vendor_doc.name, \"link_doctype\": \"Supplier\"}, limit=1) %}\n    {% set vend_addr = frappe.get_doc(\"Address\", vend_addr_list[0].name) if vend_addr_list else None %}\n{% else %}\n    {% set vend_addr = None %}\n{% endif %}\n\n<!-- HEADER -->\n<table class=\"header-table\">\n    <tr>\n        <td style=\"padding:6px 8px; vertical-align:middle; background:#ffffff !important;\">\n            <table style=\"border-collapse:collapse; width:100%;\">\n                <tr>\n                    <td style=\"border:none !important; padding:0 8px 0 0; vertical-align:middle; width:44px; background:#ffffff !important;\">\n                        <img src=\"/files/delivery-truck.png\" onerror=\"this.style.display='none';\" class=\"co-logo-img\" alt=\"logo\">\n                    </td>\n                    <td style=\"border:none !important; padding:0; vertical-align:middle; background:#ffffff !important;\">\n                        <div class=\"co-name\">{{ co_name }}</div>\n                        <div class=\"co-tagline\">Your Logistics Partner</div>\n                    </td>\n                </tr>\n            </table>\n            <div class=\"co-meta\" style=\"margin-top:4px;\">\n                {% if co_addr %}\n                    <b>Addr:</b> {{ co_addr.address_line1 or '' }}{% if co_addr.address_line2 %}, {{ co_addr.address_line2 }}{% endif %}{% if co_addr.city %}, {{ co_addr.city }}{% endif %}{% if co_addr.state %}, {{ co_addr.state }}{% endif %}{% if co_addr.pincode %} \u2013 {{ co_addr.pincode }}{% endif %}<br>\n                    {% if co_addr.phone %}<b>Tel:</b> {{ co_addr.phone }}&nbsp;&nbsp;{% endif %}\n                    {% if co_addr.email_id %}<b>Email:</b> {{ co_addr.email_id }}{% endif %}\n                {% endif %}\n                {% if company_doc %}\n                    &nbsp;&nbsp;<b>GSTIN:</b> {{ company_doc.gstin or '\u2014' }}&nbsp;&nbsp;<b>PAN:</b> {{ company_doc.pan or '\u2014' }}\n                {% endif %}\n            </div>\n        </td>\n        <td style=\"width:170px; padding:6px 8px; vertical-align:middle; text-align:right; background:#ffffff !important;\">\n            <div class=\"doc-title\">Vendor Payment</div>\n            <div class=\"doc-no\">{{ doc.name }}</div>\n            <div class=\"doc-date\">Date: {{ frappe.format_date(doc.payment_date) if doc.payment_date else '\u2014' }}</div>\n            <div style=\"margin-top:4px;\">\n                {% if doc.docstatus == 1 %}\n                    <span class=\"pill pill-green\">Submitted</span>\n                {% elif doc.docstatus == 2 %}\n                    <span class=\"pill pill-red\">Cancelled</span>\n                {% else %}\n                    <span class=\"pill pill-amber\">Draft</span>\n                {% endif %}\n            </div>\n        </td>\n    </tr>\n</table>\n\n<!-- STATUS STRIP -->\n<table class=\"status-strip\">\n    <tr>\n        <td><b>Vendor:</b> {{ doc.vendor or '\u2014' }}</td>\n        <td style=\"text-align:right;\"><b>Period:</b> {{ frappe.format_date(doc.from_date) if doc.from_date else '\u2014' }} &nbsp;\u2013&nbsp; {{ frappe.format_date(doc.to_date) if doc.to_date else '\u2014' }}&nbsp;&nbsp;&nbsp;<b>Generated:</b> {{ frappe.utils.now_datetime().strftime('%d-%b-%Y %H:%M') }}</td>\n    </tr>\n</table>\n\n<!-- TWO-COLUMN INFO GRID -->\n<table class=\"info-grid\">\n    <tr>\n        <!-- VENDOR DETAILS -->\n        <td class=\"info-col\">\n            <table class=\"card\">\n                <tr><td class=\"card-head\" colspan=\"2\">Vendor Details</td></tr>\n                <tr><td style=\"padding:0 !important; background:#ffffff !important;\">\n                    <table class=\"kv\">\n                        <tr><td class=\"k\">Vendor</td><td class=\"v\"><b>{{ doc.vendor or '\u2014' }}</b></td></tr>\n                        {% if vend_addr %}\n                        <tr><td class=\"k\">Address</td><td class=\"v\">{{ vend_addr.address_line1 or '' }}{% if vend_addr.city %}, {{ vend_addr.city }}{% endif %}{% if vend_addr.state %}, {{ vend_addr.state }}{% endif %}</td></tr>\n                        {% endif %}\n                        {% if vendor_doc and vendor_doc.get('pan') %}\n                        <tr><td class=\"k\">PAN</td><td class=\"v\">{{ vendor_doc.pan }}</td></tr>\n                        {% endif %}\n                        {% if vendor_doc and vendor_doc.get('gstin') %}\n                        <tr><td class=\"k\">GSTIN</td><td class=\"v\">{{ vendor_doc.gstin }}</td></tr>\n                        {% endif %}\n                        <tr><td class=\"k\">Period</td><td class=\"v\">{{ frappe.format_date(doc.from_date) if doc.from_date else '\u2014' }} to {{ frappe.format_date(doc.to_date) if doc.to_date else '\u2014' }}</td></tr>\n                    </table>\n                </td></tr>\n            </table>\n        </td>\n        <!-- PAYMENT DETAILS -->\n        <td class=\"info-col-r\">\n            <table class=\"card\">\n                <tr><td class=\"card-head\" colspan=\"2\">Payment Details</td></tr>\n                <tr><td style=\"padding:0 !important; background:#ffffff !important;\">\n                    <table class=\"kv\">\n                        <tr><td class=\"k\">Payment No</td><td class=\"v\"><b>{{ doc.name }}</b></td></tr>\n                        <tr><td class=\"k\">Payment Date</td><td class=\"v\">{{ frappe.format_date(doc.payment_date) if doc.payment_date else '\u2014' }}</td></tr>\n                        <tr><td class=\"k\">Mode of Payment</td><td class=\"v\">\n                            {% if doc.mode_of_payment == 'Bank Transfer' %}<span class=\"pill pill-blue\">Bank Transfer</span>\n                            {% elif doc.mode_of_payment == 'Cheque' %}<span class=\"pill pill-gray\">Cheque</span>\n                            {% elif doc.mode_of_payment == 'UPI' %}<span class=\"pill pill-green\">UPI</span>\n                            {% elif doc.mode_of_payment == 'Cash' %}<span class=\"pill pill-amber\">Cash</span>\n                            {% else %}{{ doc.mode_of_payment or '\u2014' }}{% endif %}\n                        </td></tr>\n                        {% if doc.reference_no %}\n                        <tr><td class=\"k\">Reference / UTR No</td><td class=\"v\"><b>{{ doc.reference_no }}</b></td></tr>\n                        {% endif %}\n                        {% if doc.reference_date %}\n                        <tr><td class=\"k\">Reference Date</td><td class=\"v\">{{ frappe.format_date(doc.reference_date) if doc.reference_date else '\u2014' }}</td></tr>\n                        {% endif %}\n                        {% if doc.upi_id %}\n                        <tr><td class=\"k\">UPI ID</td><td class=\"v\">{{ doc.upi_id }}</td></tr>\n                        {% endif %}\n                        {% if doc.paid_from_account %}\n                        <tr><td class=\"k\">Paid From Account</td><td class=\"v\">{{ frappe.db.get_value(\"Account Head\", doc.paid_from_account, \"name1\") or doc.paid_from_account }}</td></tr>\n                        {% endif %}\n                    </table>\n                </td></tr>\n            </table>\n        </td>\n    </tr>\n</table>\n\n<!-- TRIPS TABLE -->\n<table class=\"card\" style=\"margin-bottom:4px;\">\n    <tr><td class=\"card-head\">Trip-wise Payment Details</td></tr>\n    <tr><td style=\"padding:0 !important; background:#ffffff !important;\">\n        <table class=\"trips-table\">\n            <thead>\n                <tr>\n                    <th style=\"width:20px;\">Sr</th>\n                    <th>Trip Date</th>\n                    <th>TCN / Trip No</th>\n                    <th>LR No</th>\n                    <th>Vehicle No</th>\n                    <th style=\"text-align:right;\">Hire Amt</th>\n                    <th style=\"text-align:right;\">Balance</th>\n                    <th style=\"text-align:right;\">Payment Amt</th>\n                    <th style=\"text-align:right;\">LR Money</th>\n                    <th style=\"text-align:right;\">TDS</th>\n                    <th style=\"text-align:right;\">Transfer Amt</th>\n                    <th>Type</th>\n                    <th>Remarks</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% for row in doc.trips %}\n                <tr>\n                    <td class=\"cen\">{{ loop.index }}</td>\n                    <td class=\"cen\">{{ frappe.format_date(row.trip_date) if row.trip_date else '\u2014' }}</td>\n                    <td>{{ row.tcntrip_no or '\u2014' }}</td>\n                    <td>{{ row.lr_no or '\u2014' }}</td>\n                    <td>{{ row.vehicle_no or '\u2014' }}</td>\n                    <td class=\"num\">{{ frappe.utils.fmt_money(row.hire_amount or 0, currency='INR') }}</td>\n                    <td class=\"num\">{{ frappe.utils.fmt_money(row.balance or 0, currency='INR') }}</td>\n                    <td class=\"num\"><b>{{ frappe.utils.fmt_money(row.payment_amount or 0, currency='INR') }}</b></td>\n                    <td class=\"num\">{{ frappe.utils.fmt_money((row.employee_lr_money or 0) + (row.company_lr_money or 0), currency='INR') }}</td>\n                    <td class=\"num\">{{ frappe.utils.fmt_money(row.tds_amount or 0, currency='INR') }}</td>\n                    <td class=\"num\" style=\"color:#1a7a3c; font-weight:700;\">{{ frappe.utils.fmt_money(row.transfer_amount or 0, currency='INR') }}</td>\n                    <td class=\"cen\">{{ row.advance_or_balance or '\u2014' }}</td>\n                    <td>{{ row.row_remarks or '' }}</td>\n                </tr>\n                {% else %}\n                <tr><td colspan=\"13\" style=\"text-align:center; color:#7c6ba6; padding:8px;\">No trips found.</td></tr>\n                {% endfor %}\n            </tbody>\n            {% if doc.trips %}\n            <tfoot>\n                <tr>\n                    <td colspan=\"5\" style=\"text-align:left; font-weight:700;\">TOTAL ({{ doc.trips | length }} Trip{{ 's' if doc.trips | length != 1 else '' }})</td>\n                    <td></td>\n                    <td></td>\n                    <td class=\"num\"><b>{{ frappe.utils.fmt_money(doc.total_payment_amount or 0, currency='INR') }}</b></td>\n                    <td class=\"num\">{{ frappe.utils.fmt_money(doc.total_lr_money or 0, currency='INR') }}</td>\n                    <td class=\"num\">{{ frappe.utils.fmt_money(doc.total_tds_amount or 0, currency='INR') }}</td>\n                    <td class=\"num\" style=\"color:#1a7a3c;\"><b>{{ frappe.utils.fmt_money(doc.total_transfer_amount or 0, currency='INR') }}</b></td>\n                    <td colspan=\"2\"></td>\n                </tr>\n            </tfoot>\n            {% endif %}\n        </table>\n    </td></tr>\n</table>\n\n<!-- TOTALS SUMMARY CARDS -->\n<table class=\"totals-card\">\n    <tr>\n        <td>\n            <div class=\"t-label\">Payment Amount</div>\n            <div class=\"t-value\">{{ frappe.utils.fmt_money(doc.total_payment_amount or 0, currency='INR') }}</div>\n        </td>\n        <td>\n            <div class=\"t-label\">LR Money</div>\n            <div class=\"t-value\">{{ frappe.utils.fmt_money(doc.total_lr_money or 0, currency='INR') }}</div>\n        </td>\n        <td>\n            <div class=\"t-label\">TDS Deducted</div>\n            <div class=\"t-value\">{{ frappe.utils.fmt_money(doc.total_tds_amount or 0, currency='INR') }}</div>\n        </td>\n        <td style=\"background:#e8f4ec !important; -webkit-print-color-adjust:exact !important; print-color-adjust:exact !important;\">\n            <div class=\"t-label\" style=\"color:#1a7a3c;\">Total Transfer Amount</div>\n            <div class=\"t-value highlight\">{{ frappe.utils.fmt_money(doc.total_transfer_amount or 0, currency='INR') }}</div>\n        </td>\n    </tr>\n</table>\n\n<!-- FOOTER -->\n<div class=\"vp-footer\">\n    System-generated Vendor Payment &nbsp;|&nbsp; {{ co_name }}\n    &nbsp;|&nbsp; Payment No: <b>{{ doc.name }}</b>\n    &nbsp;|&nbsp; Vendor: <b>{{ doc.vendor or '\u2014' }}</b>\n    &nbsp;|&nbsp; Generated: {{ frappe.utils.now_datetime().strftime('%d-%b-%Y %I:%M %p') }}\n    &nbsp;|&nbsp; This is a computer-generated document.\n</div>\n\n</div>\n</body>\n</html>",
