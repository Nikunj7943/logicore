{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-04-08 17:22:01.760978",
 "css": "",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Trip",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <title>Proof of Delivery \u2013 {{ doc.name }}</title>\r\n    <style>\r\n        * { margin: 0; padding: 0; box-sizing: border-box; }\r\n\r\n        body {\r\n            font-family: 'Segoe UI', Arial, sans-serif;\r\n            font-size: 6.5pt;\r\n            line-height: 1.25;\r\n            color: #1a2b38;\r\n            background: #ffffff;\r\n            padding: 6px 8px;\r\n            -webkit-print-color-adjust: exact !important;\r\n            print-color-adjust: exact !important;\r\n        }\r\n\r\n        .page { width: 100%; background: #ffffff; }\r\n\r\n        /* HEADER */\r\n        .header-table { width: 100%; border-collapse: collapse; border-bottom: 2px solid #0d2e4e; margin-bottom: 0; }\r\n        .header-table td { border: none !important; padding: 5px 8px; vertical-align: middle; background: #ffffff !important; }\r\n        .co-logo-img { width: 32px; height: 32px; border-radius: 3px; display: block; }\r\n        .co-name { font-size: 13pt; font-weight: 700; color: #0d2e4e; letter-spacing: -0.5px; line-height: 1.1; }\r\n        .co-tagline { font-size: 6pt; color: #6b8da6; }\r\n        .co-meta { font-size: 6pt; color: #2c4a62; line-height: 1.5; margin-top: 3px; }\r\n        .co-meta b { color: #0d2e4e; font-weight: 600; }\r\n        .td-title { font-size: 7pt; font-weight: 700; color: #0d2e4e; letter-spacing: 1px; text-transform: uppercase; text-align: right; margin-bottom: 3px; }\r\n        .qr-img { width: 56px; height: 56px; border: 1px solid #dde5ed; border-radius: 2px; display: block; margin-left: auto; }\r\n        .qr-label { font-size: 5.5pt; color: #0d2e4e; font-weight: 700; text-align: center; text-transform: uppercase; letter-spacing: 0.4px; margin-top: 2px; }\r\n\r\n        /* META STRIP */\r\n        .meta-strip { width: 100%; border-collapse: collapse; background: #f4f7fa !important; border-top: 1px solid #dde5ed; border-bottom: 1px solid #dde5ed; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }\r\n        .meta-strip td { padding: 3px 8px; font-size: 6.5pt; background: #f4f7fa !important; border: none !important; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }\r\n        .meta-strip b { color: #0d2e4e; }\r\n        .trip-id-mono { font-family: 'Courier New', monospace; font-size: 7.5pt; font-weight: 700; color: #0d2e4e; }\r\n\r\n        /* PILLS */\r\n        .pill { display: inline; padding: 1px 6px; border-radius: 20px; font-size: 6pt; font-weight: 700; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }\r\n        .pill-green { background: #e6f4ec !important; color: #1a7a3c !important; border: 1px solid #aed6bc; }\r\n        .pill-red   { background: #fdeaea !important; color: #aa2020 !important; border: 1px solid #f0b8b8; }\r\n        .pill-amber { background: #fff4e0 !important; color: #995c00 !important; border: 1px solid #f0cfa0; }\r\n        .pill-gray  { background: #eef2f7 !important; color: #2d4f6b !important; border: 1px solid #c8d8e6; }\r\n\r\n        /* BODY */\r\n        .body-table { width: 100%; border-collapse: collapse; margin-top: 5px; }\r\n        .body-table > tbody > tr > td { border: none !important; padding: 0; vertical-align: top; }\r\n        .col-l { width: 50%; padding-right: 4px !important; }\r\n        .col-r { width: 50%; padding-left:  4px !important; }\r\n\r\n        /* CARD */\r\n        .card { width: 100%; border-collapse: collapse; border: 1px solid #dde5ed; margin-bottom: 5px; }\r\n        .card-head td {\r\n            background: #0d2e4e !important; color: #ffffff !important;\r\n            font-size: 6pt; font-weight: 700; letter-spacing: 0.7px; text-transform: uppercase;\r\n            padding: 3px 8px; text-align: center;\r\n            -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important;\r\n        }\r\n\r\n        /* KV */\r\n        .kv { width: 100%; border-collapse: collapse; }\r\n        .kv td { border-bottom: 1px solid #dde5ed; border-right: 1px solid #dde5ed; padding: 2px 6px; font-size: 6.2pt; vertical-align: top; background: #ffffff !important; }\r\n        .kv tr:last-child td { border-bottom: none !important; }\r\n        .kv td:last-child    { border-right: none !important; }\r\n        .kv .k { color: #1a6faa; font-weight: 600; width: 46%; }\r\n        .kv .v { color: #1a2b38; }\r\n        .kv .v b { font-weight: 700; color: #0d2e4e; }\r\n        .kv .total-row td { background: #f0f4f8 !important; font-weight: 700; color: #0d2e4e !important; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }\r\n\r\n        /* ADDRESS */\r\n        .addr-split { width: 100%; border-collapse: collapse; }\r\n        .addr-split td { width: 50%; border-right: 1px solid #dde5ed; padding: 4px 8px; vertical-align: top; font-size: 6.2pt; background: #ffffff !important; }\r\n        .addr-split td:last-child { border-right: none !important; }\r\n        .addr-lbl { font-size: 6pt; font-weight: 700; color: #1a6faa; text-transform: uppercase; letter-spacing: 0.3px; margin-bottom: 2px; }\r\n        .addr-val { color: #1a2b38; line-height: 1.5; }\r\n\r\n        /* REMARKS */\r\n        .remarks-box { padding: 4px 8px; font-size: 6.2pt; color: #1a2b38; background: #ffffff !important; min-height: 18px; }\r\n\r\n        /* SIGNATURES */\r\n        .sig-outer { width: 100%; border-collapse: collapse; border: 1px solid #dde5ed; margin-top: 5px; }\r\n        .sig-head td { background: #0d2e4e !important; color: #ffffff !important; font-size: 6pt; font-weight: 700; letter-spacing: 0.7px; text-transform: uppercase; padding: 3px 8px; text-align: center; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }\r\n        .sig-cols td { width: 33.33%; border-right: 1px solid #dde5ed; padding: 5px 8px; vertical-align: top; background: #ffffff !important; }\r\n        .sig-cols td:last-child { border-right: none !important; }\r\n        .sig-col-title { font-size: 6pt; font-weight: 700; color: #0d2e4e; text-transform: uppercase; letter-spacing: 0.3px; border-bottom: 1px solid #0d2e4e; padding-bottom: 2px; margin-bottom: 4px; }\r\n        .sig-space { height: 24px; border-bottom: 1px solid #96b0c6; margin-bottom: 3px; }\r\n        .sig-f { font-size: 6pt; color: #4b6f8c; margin-top: 2px; line-height: 1.4; }\r\n        .sig-v { font-weight: 600; color: #1a2b38; }\r\n\r\n        /* FOOTER */\r\n        .pod-footer { background: #f4f7fa !important; border-top: 1px solid #dde5ed; padding: 3px 8px; text-align: center; font-size: 5.8pt; color: #4a6a85; margin-top: 5px; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }\r\n\r\n        @media print {\r\n            body { padding: 4px 6px; background: #fff; }\r\n            * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }\r\n        }\r\n    </style>\r\n</head>\r\n<body>\r\n<div class=\"page\">\r\n\r\n{% set company_doc = frappe.get_doc(\"Company\", doc.company) if doc.company and frappe.db.exists(\"Company\", doc.company) else None %}\r\n{% set co_name = company_doc.company_name if company_doc else (doc.company or \"Company\") %}\r\n{% if company_doc %}\r\n    {% set addr_list = frappe.get_list(\"Address\", filters={\"link_name\": company_doc.name, \"link_doctype\": \"Company\"}, limit=1) %}\r\n    {% set co_addr = frappe.get_doc(\"Address\", addr_list[0].name) if addr_list else None %}\r\n{% else %}\r\n    {% set co_addr = None %}\r\n{% endif %}\r\n\r\n<!-- HEADER -->\r\n<table class=\"header-table\">\r\n    <tr>\r\n        <td style=\"padding:5px 8px; vertical-align:middle; background:#ffffff !important;\">\r\n            <table style=\"border-collapse:collapse; width:100%;\">\r\n                <tr>\r\n                    <td style=\"border:none !important; padding:0 6px 0 0; vertical-align:middle; width:38px; background:#ffffff !important;\">\r\n                        <img src=\"/files/delivery-truck.png\" onerror=\"this.style.display='none';\" class=\"co-logo-img\" alt=\"logo\">\r\n                    </td>\r\n                    <td style=\"border:none !important; padding:0; vertical-align:middle; background:#ffffff !important;\">\r\n                        <div class=\"co-name\">{{ co_name }}</div>\r\n                        <div class=\"co-tagline\">Your Logistics Partner</div>\r\n                    </td>\r\n                </tr>\r\n            </table>\r\n            <div class=\"co-meta\">\r\n                {% if co_addr %}\r\n                    <b>Addr:</b> {{ co_addr.address_line1 or '' }}{% if co_addr.address_line2 %}, {{ co_addr.address_line2 }}{% endif %}{% if co_addr.city %}, {{ co_addr.city }}{% endif %}{% if co_addr.state %}, {{ co_addr.state }}{% endif %}{% if co_addr.pincode %} \u2013 {{ co_addr.pincode }}{% endif %}\r\n                    {% if co_addr.phone %}&nbsp;<b>Tel:</b> {{ co_addr.phone }}{% endif %}\r\n                    {% if co_addr.email_id %}&nbsp;<b>Email:</b> {{ co_addr.email_id }}{% endif %}<br>\r\n                {% endif %}\r\n                {% if company_doc %}\r\n                    <b>GSTIN:</b> {{ company_doc.gstin or '\u2014' }}&nbsp;&nbsp;<b>PAN:</b> {{ company_doc.pan or '\u2014' }}\r\n                {% else %}\r\n                    <b>GSTIN:</b> 27AAACA1234A1Z\r\n                {% endif %}\r\n            </div>\r\n        </td>\r\n        <td style=\"width:110px; padding:5px 8px; vertical-align:middle; text-align:right; background:#ffffff !important;\">\r\n            <div class=\"td-title\">Trip Details</div>\r\n            <img class=\"qr-img\" src=\"https://api.qrserver.com/v1/create-qr-code/?size=56x56&data={{ doc.name }}\" alt=\"QR\">\r\n            <div class=\"qr-label\">TRIP ID</div>\r\n            <div class=\"qr-label\" style=\"font-family:'Courier New',monospace;\">{{ doc.name }}</div>\r\n        </td>\r\n    </tr>\r\n</table>\r\n\r\n<!-- META STRIP -->\r\n<table class=\"meta-strip\">\r\n    <tr>\r\n        <td><b>Branch:</b> {{ doc.branch or '\u2014' }}&nbsp;&nbsp;&nbsp;<b>Generated:</b> {{ frappe.utils.now_datetime().strftime('%d-%b-%Y %H:%M') }}</td>\r\n        <td style=\"text-align:right;\">\r\n            <b>Trip ID:</b> <span class=\"trip-id-mono\">{{ doc.name }}</span>&nbsp;&nbsp;\r\n            {% set ps = (doc.pod_status or '').lower() %}\r\n            {% if 'delivered' in ps or 'completed' in ps %}<span class=\"pill pill-green\">Delivered</span>\r\n            {% elif 'partial' in ps %}<span class=\"pill pill-amber\">Partial</span>\r\n            {% elif ps %}<span class=\"pill pill-red\">{{ doc.pod_status }}</span>\r\n            {% else %}<span class=\"pill pill-green\">Open</span>{% endif %}\r\n        </td>\r\n    </tr>\r\n</table>\r\n\r\n<!-- TWO-COLUMN BODY -->\r\n<table class=\"body-table\">\r\n    <tr>\r\n        <!-- LEFT -->\r\n        <td class=\"col-l\">\r\n\r\n            <!-- TRIP INFORMATION -->\r\n            <table class=\"card\">\r\n                <tr><td class=\"card-head\" colspan=\"99\" style=\"background:#0d2e4e !important; color:#ffffff !important; -webkit-print-color-adjust:exact !important; print-color-adjust:exact !important; font-size:6pt; font-weight:700; letter-spacing:0.7px; text-transform:uppercase; padding:3px 8px; text-align:center;\">Trip Information</td></tr>\r\n                <tr><td style=\"padding:0 !important; background:#ffffff !important;\">\r\n                    <table class=\"kv\">\r\n                        <tr><td class=\"k\">Branch</td><td class=\"v\">{{ doc.branch or '\u2014' }}</td></tr>\r\n                        <tr><td class=\"k\">Business Format</td><td class=\"v\">{{ doc.trip_type or 'Standard' }}</td></tr>\r\n                        <tr><td class=\"k\">Trip Date</td><td class=\"v\">{{ doc.tcntrip_date or doc.posting_date or '\u2014' }}</td></tr>\r\n                        <tr><td class=\"k\">Customer</td><td class=\"v\"><b>{{ doc.customer or '\u2014' }}</b></td></tr>\r\n                        <tr><td class=\"k\">Trip No / Load ID</td><td class=\"v\"><b>{{ doc.tcntrip_no or doc.name or '\u2014' }}</b></td></tr>\r\n                        <tr><td class=\"k\">Indent No</td><td class=\"v\">{{ doc.indent_no or '\u2014' }}{% if doc.indent_date %} ({{ doc.indent_date }}){% endif %}</td></tr>\r\n                        <tr><td class=\"k\">SF</td><td class=\"v\">{{ doc.sf or '\u2014' }}</td></tr>\r\n                        <tr><td class=\"k\">Billing Start / End</td><td class=\"v\">{{ doc.billing_start or 'N/A' }} / {{ doc.billing_end or 'N/A' }}</td></tr>\r\n                    </table>\r\n                </td></tr>\r\n            </table>\r\n\r\n            <!-- ROUTE DETAILS -->\r\n            <table class=\"card\">\r\n                <tr><td class=\"card-head\" colspan=\"99\" style=\"background:#0d2e4e !important; color:#ffffff !important; -webkit-print-color-adjust:exact !important; print-color-adjust:exact !important; font-size:6pt; font-weight:700; letter-spacing:0.7px; text-transform:uppercase; padding:3px 8px; text-align:center;\">Route Details</td></tr>\r\n                <tr><td style=\"padding:0 !important; background:#ffffff !important;\">\r\n                    <table class=\"kv\">\r\n                        <tr><td class=\"k\">Origin City</td><td class=\"v\">{{ doc.origin_city or '\u2014' }}{% if doc.origin_city_2 %} / {{ doc.origin_city_2 }}{% endif %} &nbsp;<span style=\"color:#6b8da6;\">{{ doc.origin_state or '' }}</span></td></tr>\r\n                        <tr><td class=\"k\">Destination 1</td><td class=\"v\">{{ doc.destination_city_1 or 'N/A' }}{% if doc.destination_state %}, {{ doc.destination_state }}{% endif %}</td></tr>\r\n                        <tr><td class=\"k\">Destination 2</td><td class=\"v\">{{ doc.destination_city_2 or 'N/A' }}</td></tr>\r\n                        <tr><td class=\"k\">LR No / Date</td><td class=\"v\">{{ doc.lr_no or '\u2014' }} / {{ doc.lr_date or '\u2014' }}</td></tr>\r\n                    </table>\r\n                </td></tr>\r\n            </table>\r\n\r\n        </td>\r\n\r\n        <!-- RIGHT -->\r\n        <td class=\"col-r\">\r\n            <!-- FREIGHT & CHARGES -->\r\n            <table class=\"card\">\r\n                <tr><td class=\"card-head\" colspan=\"99\" style=\"background:#0d2e4e !important; color:#ffffff !important; -webkit-print-color-adjust:exact !important; print-color-adjust:exact !important; font-size:6pt; font-weight:700; letter-spacing:0.7px; text-transform:uppercase; padding:3px 8px; text-align:center;\">Freight &amp; Charges</td></tr>\r\n                <tr><td style=\"padding:0 !important; background:#ffffff !important;\">\r\n                    <table class=\"kv\">\r\n                        <tr><td class=\"k\">Vendor Freight</td><td class=\"v\" style=\"text-align:right;\">Rs. {{ doc.vendor_freight or '0' }}</td></tr>\r\n                        <tr><td class=\"k\">Vendor Freight (Extra)</td><td class=\"v\" style=\"text-align:right;\">Rs. {{ doc.vendor_freight_extra or '0' }}</td></tr>\r\n                        <tr><td class=\"k\">Total Vendor Freight</td><td class=\"v\" style=\"text-align:right;\"><b>Rs. {{ doc.total_vendor_freight or '0' }}</b></td></tr>\r\n                        <tr><td class=\"k\">Customer Freight</td><td class=\"v\" style=\"text-align:right;\">Rs. {{ doc.customer_freight or '0' }}</td></tr>\r\n                        <tr><td class=\"k\">Weighment</td><td class=\"v\" style=\"text-align:right;\">Rs. {{ doc.weighment or '0' }}</td></tr>\r\n                        <tr><td class=\"k\">Detention (Days / Charges)</td><td class=\"v\" style=\"text-align:right;\">{{ doc.detention_days or '0' }} / Rs. {{ doc.detention_charges or '0' }}</td></tr>\r\n                        <tr><td class=\"k\">Loading / Unloading</td><td class=\"v\" style=\"text-align:right;\">Rs. {{ doc.loading_unloading or '0' }}</td></tr>\r\n                        <tr class=\"total-row\">\r\n                            <td class=\"k\" style=\"background:#f0f4f8 !important; font-weight:700; color:#0d2e4e !important; -webkit-print-color-adjust:exact !important; print-color-adjust:exact !important;\">Total Trip Amount</td>\r\n                            <td class=\"v\" style=\"text-align:right; background:#f0f4f8 !important; font-weight:700; color:#0d2e4e !important; -webkit-print-color-adjust:exact !important; print-color-adjust:exact !important;\">Rs. {{ doc.total_trip_amount or doc.goods_value or '0' }}</td>\r\n                        </tr>\r\n                    </table>\r\n                </td></tr>\r\n            </table>\r\n\r\n            <!-- VENDOR & VEHICLE -->\r\n            <table class=\"card\">\r\n                <tr><td class=\"card-head\" colspan=\"99\" style=\"background:#0d2e4e !important; color:#ffffff !important; -webkit-print-color-adjust:exact !important; print-color-adjust:exact !important; font-size:6pt; font-weight:700; letter-spacing:0.7px; text-transform:uppercase; padding:3px 8px; text-align:center;\">Vendor &amp; Vehicle</td></tr>\r\n                <tr><td style=\"padding:0 !important; background:#ffffff !important;\">\r\n                    <table class=\"kv\">\r\n                        <tr><td class=\"k\">Vendor / Transporter</td><td class=\"v\">{{ doc.vendor or doc.transporter or '\u2014' }}</td></tr>\r\n                        <tr><td class=\"k\">Vehicle Type / No</td><td class=\"v\">{{ doc.vehicle_type or '\u2014' }} &nbsp;<b>{{ doc.vehicle_no or '' }}</b></td></tr>\r\n                        <tr><td class=\"k\">Driver</td><td class=\"v\">{{ doc.driver or '\u2014' }}</td></tr>\r\n                        <tr><td class=\"k\">Driver Contact / License</td><td class=\"v\">{{ doc.driver_mobile or 'N/A' }} / {{ doc.driver_license_no or 'N/A' }}</td></tr>\r\n                        <tr><td class=\"k\">Market Vehicle No</td><td class=\"v\">{{ doc.market_vehicle_no or 'N/A' }}</td></tr>\r\n                        <tr><td class=\"k\">Capacity / Model</td><td class=\"v\">{{ doc.vehicle_capacity or 'N/A' }} / {{ doc.vehicle_model or 'N/A' }}</td></tr>\r\n                        <tr><td class=\"k\">Goods Type / Pkgs</td><td class=\"v\">{{ doc.types_of_good or '\u2014' }} / {{ doc.packages or '0' }}</td></tr>\r\n                    </table>\r\n                </td></tr>\r\n            </table>\r\n\r\n        </td>\r\n    </tr>\r\n</table>\r\n\r\n<!-- ADDRESSES \u2013 FULL WIDTH -->\r\n<table class=\"card\" style=\"margin-top:2px;\">\r\n    <tr><td class=\"card-head\" colspan=\"99\" style=\"background:#0d2e4e !important; color:#ffffff !important; -webkit-print-color-adjust:exact !important; print-color-adjust:exact !important; font-size:6pt; font-weight:700; letter-spacing:0.7px; text-transform:uppercase; padding:3px 8px; text-align:center;\">Origin &amp; Destination Addresses</td></tr>\r\n    <tr><td style=\"padding:0 !important; background:#ffffff !important;\">\r\n        <table class=\"addr-split\">\r\n            <tr>\r\n                <td style=\"background:#ffffff !important; border-right:1px solid #dde5ed; padding:4px 8px; vertical-align:top; width:50%;\">\r\n                    <div class=\"addr-lbl\">Origin Address</div>\r\n                    <div class=\"addr-val\">\r\n                        {%- if doc.origin_address_1 and frappe.db.exists(\"Address\", doc.origin_address_1) -%}{{ frappe.get_doc(\"Address\", doc.origin_address_1).get_display() }}\r\n                        {%- elif doc.origin_address -%}{{ doc.origin_address }}{%- else -%}\u2014{%- endif -%}\r\n                    </div>\r\n                </td>\r\n                <td style=\"background:#ffffff !important; padding:4px 8px; vertical-align:top; width:50%;\">\r\n                    <div class=\"addr-lbl\">Destination Address</div>\r\n                    <div class=\"addr-val\">\r\n                        {%- if doc.destination_address_1 and frappe.db.exists(\"Address\", doc.destination_address_1) -%}{{ frappe.get_doc(\"Address\", doc.destination_address_1).get_display() }}\r\n                        {%- elif doc.destination_address -%}{{ doc.destination_address }}{%- else -%}\u2014{%- endif -%}\r\n                    </div>\r\n                </td>\r\n            </tr>\r\n        </table>\r\n    </td></tr>\r\n</table>\r\n\r\n<!-- REMARKS -->\r\n<table class=\"card\" style=\"margin-top:4px;\">\r\n    <tr><td class=\"card-head\" colspan=\"99\" style=\"background:#0d2e4e !important; color:#ffffff !important; -webkit-print-color-adjust:exact !important; print-color-adjust:exact !important; font-size:6pt; font-weight:700; letter-spacing:0.7px; text-transform:uppercase; padding:3px 8px; text-align:center;\">Remarks</td></tr>\r\n    <tr><td style=\"padding:0 !important; background:#ffffff !important;\">\r\n        <div class=\"remarks-box\">{{ doc.remarks or doc.shipping_instruction or '\u2014' }}</div>\r\n    </td></tr>\r\n</table>\r\n\r\n<!-- SIGNATURES \u2013 3 COLS -->\r\n<table class=\"sig-outer\" style=\"margin-top:4px;\">\r\n    <tr class=\"sig-head\">\r\n        <td colspan=\"3\" style=\"background:#0d2e4e !important; color:#ffffff !important; -webkit-print-color-adjust:exact !important; print-color-adjust:exact !important; font-size:6pt; font-weight:700; letter-spacing:0.7px; text-transform:uppercase; padding:3px 8px; text-align:center;\">Acknowledgement &amp; Signatures</td>\r\n    </tr>\r\n    <tr class=\"sig-cols\">\r\n        <td style=\"background:#ffffff !important; width:33.33%; border-right:1px solid #dde5ed; padding:5px 8px; vertical-align:top;\">\r\n            <div class=\"sig-col-title\">Receiver's Signature &amp; Stamp</div>\r\n            <div class=\"sig-space\"></div>\r\n            <div class=\"sig-f\">Name: _______________________________</div>\r\n            <div class=\"sig-f\">Date: ______ / ______ / ______</div>\r\n            <div class=\"sig-f\">Designation: _________________________</div>\r\n        