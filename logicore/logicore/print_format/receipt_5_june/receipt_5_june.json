 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\r\n* { box-sizing: border-box; margin: 0; padding: 0; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }\r\n\r\nbody {\r\n    font-family: Arial, sans-serif;\r\n    font-size: 11px;\r\n    color: #000;\r\n    background: #fff;\r\n    padding: 6px 4px;\r\n}\r\n\r\n/* \u2500\u2500 HEADER \u2500\u2500 */\r\ntable.t-header { width: 100%; border-collapse: collapse; margin-bottom: 4px; }\r\ntable.t-header td { border: none; padding: 2px 4px; vertical-align: top; }\r\n.co-name    { font-size: 20px; font-weight: bold; line-height: 1.3; color: #1a5276; }\r\n.co-addr    { font-size: 10px; line-height: 1.6; }\r\n.co-contact { font-size: 10px; line-height: 1.8; }\r\nhr.divider  { border: none; border-top: 2px solid #1a5276; margin: 8px 0 14px 0; }\r\n\r\n/* Header cell */\r\ntd.tbl-hdr { background: #eaf0f6 !important; color: #1a5276 !important; font-weight: bold; font-size: 11px; padding: 6px 8px; text-align: left; border-bottom: 1px solid #b8cfe0; border-right: 1px solid #b8cfe0; -webkit-print-color-adjust: exact !important; }\r\ntd.tbl-hdr.th-r { text-align: right; }\r\ntd.tbl-hdr:last-child { border-right: none; }\r\n\r\n/* \u2500\u2500 INFO BLOCK \u2500\u2500 */\r\ntable.t-info { width: 100%; border-collapse: collapse; margin-bottom: 14px; }\r\ntable.t-info > tbody > tr > td { border: none; padding: 0; vertical-align: top; }\r\n\r\n/* Receipt Slip box */\r\ntable.t-ssbox { border-collapse: collapse; width: 100%; border: 1px solid #b8cfe0; }\r\ntable.t-ssbox td { padding: 5px 8px; font-size: 11px; border-bottom: 1px solid #d4e6f1; vertical-align: middle; color: #000; }\r\ntable.t-ssbox td.ss-hdr { background: #2471a3; color: #fff; font-weight: bold; font-size: 12px; text-align: center; border-bottom: 1px solid #1a5276; letter-spacing: 1px; }\r\ntable.t-ssbox td.ss-lbl { width: 160px; font-weight: bold; color: #1a5276; }\r\n\r\n/* Customer info box */\r\ntable.t-custbox { border-collapse: collapse; width: 100%; border: 1px solid #b8cfe0; }\r\ntable.t-custbox td { padding: 5px 8px; font-size: 11px; border-bottom: 1px solid #d4e6f1; vertical-align: middle; color: #000; }\r\ntable.t-custbox td.cust-hdr { background: #2471a3; color: #fff; font-weight: bold; font-size: 14px; text-align: left; border-bottom: 1px solid #1a5276; }\r\ntable.t-custbox td.cust-lbl { width: 185px; font-weight: bold; color: #1a5276; }\r\n\r\n/* \u2500\u2500 SHARED SECTION HEADING BAR \u2500\u2500 */\r\ntable.t-sec-hdr { width: 100%; border-collapse: collapse; margin-bottom: 0; }\r\ntable.t-sec-hdr td {\r\n    background: #1a5276;\r\n    color: #fff;\r\n    padding: 6px 8px;\r\n    font-size: 11px;\r\n    font-weight: bold;\r\n    letter-spacing: 1px;\r\n    border: 1px solid #1a5276;\r\n    border-bottom: none;\r\n}\r\n\r\n/* \u2500\u2500 TRIP DETAIL TABLE \u2500\u2500 */\r\ntable.t-detail { width: 100%; border-collapse: collapse; margin-bottom: 14px; border: 1px solid #b8cfe0; }\r\ntable.t-detail td.tbl-hdr { border-right: 1px solid #b8cfe0; }\r\ntable.t-detail td.tbl-hdr:last-child { border-right: none; }\r\ntable.t-detail td {\r\n    padding: 5px 8px;\r\n    font-size: 11px;\r\n    border-bottom: 1px solid #d4e6f1;\r\n    border-right: 1px solid #d4e6f1;\r\n    vertical-align: middle;\r\n    color: #000;\r\n}\r\ntable.t-detail td.td-r { text-align: right; }\r\ntable.t-detail td:last-child { border-right: none; }\r\ntable.t-detail tfoot td {\r\n    background: #eaf0f6;\r\n    font-weight: bold;\r\n    border-top: 1.5px solid #b8cfe0;\r\n    border-bottom: none;\r\n    padding: 6px 8px;\r\n}\r\ntable.t-detail tfoot td.td-r { text-align: right; }\r\n\r\n/* \u2500\u2500 SUMMARY TOTALS GRID \u2500\u2500 */\r\ntable.t-net-grid { width: 100%; border-collapse: collapse; margin-bottom: 14px; border: 1px solid #b8cfe0; }\r\ntable.t-net-grid td.tbl-hdr { border-right: 1px solid #b8cfe0; }\r\ntable.t-net-grid td.tbl-hdr:last-child { border-right: none; }\r\ntable.t-net-grid td.val { padding: 7px 8px; font-size: 12px; font-weight: bold; border-right: 1px solid #d4e6f1; color: #000; }\r\ntable.t-net-grid td.val:last-child { border-right: none; }\r\n\r\n/* \u2500\u2500 REMARKS \u2500\u2500 */\r\ntable.t-rem { width: 100%; border-collapse: collapse; margin-bottom: 10px; }\r\ntable.t-rem td { border: none; padding: 3px 0; font-size: 11px; vertical-align: top; }\r\ntable.t-rem td.r-lbl { font-weight: bold; white-space: nowrap; padding-right: 6px; width: 130px; }\r\ntable.t-rem td.r-val { font-size: 10.5px; line-height: 1.5; }\r\n\r\n/* \u2500\u2500 SIGNATURE BLOCK \u2500\u2500 */\r\ntable.t-sign { width: 100%; border-collapse: collapse; margin-top: 30px; }\r\ntable.t-sign td { border: none; font-size: 11px; text-align: center; padding: 0 8px; }\r\ntable.t-sign td .sign-line { border-top: 1px solid #000; margin-top: 30px; padding-top: 4px; }\r\n\r\n/* \u2500\u2500 FOOTER \u2500\u2500 */\r\ntable.t-foot { width: 100%; border-collapse: collapse; margin-top: 14px; }\r\ntable.t-foot td { border: none; font-size: 10px; color: #666; text-align: center; }\r\n</style>\r\n\r\n{# \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\r\n   SECTION 1 \u2014 COMPANY HEADER\r\n\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 #}\r\n<table class=\"t-header\">\r\n    <tr>\r\n        <td style=\"width:55%;\">\r\n            <table style=\"border-collapse:collapse;\">\r\n                <tr><td class=\"co-name\">{{ doc.company }}</td></tr>\r\n                <tr><td class=\"co-addr\">A-112, BAIJAL BUSINESS, OPPOSITE SHYAMICON, VILLAGE<br>ASLALI, TALUKA DASKROI</td></tr>\r\n            </table>\r\n        </td>\r\n        <td style=\"width:45%; vertical-align:top;\">\r\n            <table style=\"border-collapse:collapse;width:100%;\">\r\n                <tr><td class=\"co-contact\">PHONE: NA</td></tr>\r\n                <tr><td class=\"co-contact\">EMAIL : rkmlogistics3@gmail.com</td></tr>\r\n                <tr><td class=\"co-contact\">WEBSITE : NA</td></tr>\r\n            </table>\r\n        </td>\r\n    </tr>\r\n</table>\r\n<hr class=\"divider\">\r\n\r\n{# \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\r\n   SECTION 2 \u2014 CUSTOMER INFO + RECEIPT BOX\r\n\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 #}\r\n<table class=\"t-info\">\r\n    <tr>\r\n        <td style=\"width:50%; padding-right:8px; vertical-align:top;\">\r\n            <table class=\"t-custbox\">\r\n                <tr>\r\n                    <td class=\"cust-hdr\" colspan=\"2\">{{ doc.customer }}</td>\r\n                </tr>\r\n                <tr><td class=\"cust-lbl\">MODE OF PAYMENT:</td>   <td>{{ doc.mode_of_payment or \"\" }}</td></tr>\r\n                <tr><td class=\"cust-lbl\">FROM DATE:</td>          <td>{{ frappe.utils.formatdate(doc.from_date, 'dd-MM-yyyy') }}</td></tr>\r\n                <tr><td class=\"cust-lbl\">TO DATE:</td>            <td>{{ frappe.utils.formatdate(doc.to_date, 'dd-MM-yyyy') }}</td></tr>\r\n            </table>\r\n        </td>\r\n        <td style=\"width:50%; vertical-align:top;\">\r\n            <table class=\"t-ssbox\">\r\n                <tr>\r\n                    <td class=\"ss-hdr\" colspan=\"2\">RECEIPT</td>\r\n                </tr>\r\n                <tr><td class=\"ss-lbl\">RECEIPT NO.:</td>         <td>{{ doc.name }}</td></tr>\r\n                <tr><td class=\"ss-lbl\">POSTING DATE:</td>        <td>{{ frappe.utils.formatdate(doc.payment_date, 'dd-MM-yyyy') }}</td></tr>\r\n                <tr><td class=\"ss-lbl\">TOTAL INVOICE AMT:</td>   <td>&#8377; {{ \"{:,.0f}\".format(doc.total_invoice_amount or 0) }}</td></tr>\r\n                <tr><td class=\"ss-lbl\">TOTAL TDS:</td>           <td>&#8377; {{ \"{:,.0f}\".format(doc.total_tds_amount or 0) }}</td></tr>\r\n                <tr><td class=\"ss-lbl\">TOTAL BROKERAGE:</td>     <td>&#8377; {{ \"{:,.0f}\".format(doc.total_brokerage_amount or 0) }}</td></tr>\r\n                <tr><td class=\"ss-lbl\">TOTAL LR MONEY:</td>      <td>&#8377; {{ \"{:,.0f}\".format(doc.total_lr_money or 0) }}</td></tr>\r\n                <tr><td class=\"ss-lbl\">TOTAL RECEIVED AMT:</td>  <td><strong>&#8377; {{ \"{:,.0f}\".format(doc.total_received_amount or 0) }}</strong></td></tr>\r\n            </table>\r\n        </td>\r\n    </tr>\r\n</table>\r\n\r\n{# \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\r\n   SECTION 3 \u2014 TRIP DETAILS TABLE\r\n\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 #}\r\n<table class=\"t-sec-hdr\"><tr><td>TRIP DETAILS</td></tr></table>\r\n<table class=\"t-detail\">\r\n    <thead>\r\n        <tr>\r\n            <td class=\"tbl-hdr\" style=\"width:4%;\">NO</td>\r\n            <td class=\"tbl-hdr\" style=\"width:12%;\">TRIP NO</td>\r\n            <td class=\"tbl-hdr\" style=\"width:9%;\">TRIP DATE</td>\r\n            <td class=\"tbl-hdr\" style=\"width:9%;\">TCN/TRIP NO</td>\r\n            <td class=\"tbl-hdr\" style=\"width:8%;\">LR NO</td>\r\n            <td class=\"tbl-hdr\" style=\"width:9%;\">FROM</td>\r\n            <td class=\"tbl-hdr\" style=\"width:9%;\">TO</td>\r\n            <td class=\"tbl-hdr th-r\" style=\"width:10%;\">INVOICE AMT</td>\r\n            <td class=\"tbl-hdr th-r\" style=\"width:8%;\">TDS</td>\r\n            <td class=\"tbl-hdr th-r\" style=\"width:10%;\">RECEIVED AMT</td>\r\n            <td class=\"tbl-hdr th-r\" style=\"width:9%;\">NET RECEIVED</td>\r\n            <td class=\"tbl-hdr\" style=\"width:13%;\">UTR NO</td>\r\n        </tr>\r\n    </thead>\r\n    <tbody>\r\n        {% set ns = namespace(tot_invoice=0, tot_tds=0, tot_received=0, tot_net=0) %}\r\n        {% for row in doc.trips %}\r\n        {% set ns.tot_invoice  = ns.tot_invoice  + (row.invoice_amount  | float) %}\r\n        {% set ns.tot_tds      = ns.tot_tds      + (row.tds_amount      | float) %}\r\n        {% set ns.tot_received = ns.tot_received + (row.received_amount  | float) %}\r\n        {% set ns.tot_net      = ns.tot_net      + (row.net_received     | float) %}\r\n        <tr>\r\n            <td>{{ loop.index }}</td>\r\n            <td>{{ row.trip or \"\" }}</td>\r\n            <td>{{ frappe.utils.formatdate(row.trip_date, 'dd-MM-yyyy') if row.trip_date else \"\" }}</td>\r\n            <td>{{ row.tcntrip_no or \"\" }}</td>\r\n            <td>{{ row.lr_no or \"\" }}</td>\r\n            <td>{{ row.origin_city or \"\" }}</td>\r\n            <td>{{ row.destination_city or \"\" }}</td>\r\n            <td class=\"td-r\">&#8377; {{ \"{:,.0f}\".format(row.invoice_amount | float) }}</td>\r\n            <td class=\"td-r\">&#8377; {{ \"{:,.0f}\".format(row.tds_amount | float) }}</td>\r\n            <td class=\"td-r\">&#8377; {{ \"{:,.0f}\".format(row.received_amount | float) }}</td>\r\n            <td class=\"td-r\"><strong>&#8377; {{ \"{:,.0f}\".format(row.net_received | float) }}</strong></td>\r\n            <td>{{ row.utr_no or \"\" }}</td>\r\n        </tr>\r\n        {% endfor %}\r\n    </tbody>\r\n    <tfoot>\r\n        <tr>\r\n            <td colspan=\"7\" style=\"font-weight:bold; background:#eaf0f6;\">TOTAL</td>\r\n            <td class=\"td-r\" style=\"background:#eaf0f6; font-weight:bold;\">&#8377; {{ \"{:,.0f}\".format(ns.tot_invoice) }}</td>\r\n            <td class=\"td-r\" style=\"background:#eaf0f6; font-weight:bold;\">&#8377; {{ \"{:,.0f}\".format(ns.tot_tds) }}</td>\r\n            <td class=\"td-r\" style=\"background:#eaf0f6; font-weight:bold;\">&#8377; {{ \"{:,.0f}\".format(ns.tot_received) }}</td>\r\n            <td class=\"td-r\" style=\"background:#eaf0f6; font-weight:bold;\">&#8377; {{ \"{:,.0f}\".format(ns.tot_net) }}</td>\r\n            <td style=\"background:#eaf0f6;\"></td>\r\n        </tr>\r\n    </tfoot>\r\n</table>\r\n\r\n{# \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\r\n   SECTION 4 \u2014 SUMMARY TOTALS GRID\r\n\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 #}\r\n<table class=\"t-net-grid\">\r\n    <thead>\r\n        <tr>\r\n            <td class=\"tbl-hdr\" style=\"width:20%;\">TOTAL INVOICE AMT [A]</td>\r\n            <td class=\"tbl-hdr\" style=\"width:20%;\">TOTAL TDS [B]</td>\r\n            <td class=\"tbl-hdr\" style=\"width:20%;\">TOTAL BROKERAGE [C]</td>\r\n            <td class=\"tbl-hdr\" style=\"width:20%;\">TOTAL LR MONEY [D]</td>\r\n            <td class=\"tbl-hdr\" style=\"width:20%;\">TOTAL RECEIVED [A-B-C-D]</td>\r\n        </tr>\r\n    </thead>\r\n    <tbody>\r\n        <tr>\r\n            <td class=\"val\">&#8377; {{ \"{:,.0f}\".format(doc.total_invoice_amount or 0) }}</td>\r\n            <td class=\"val\">&#8377; {{ \"{:,.0f}\".format(doc.total_tds_amount or 0) }}</td>\r\n            <td class=\"val\">&#8377; {{ \"{:,.0f}\".format(doc.total_brokerage_amount or 0) }}</td>\r\n            <td class=\"val\">&#8377; {{ \"{:,.0f}\".format(doc.total_lr_money or 0) }}</td>\r\n            <td class=\"val\">&#8377; {{ \"{:,.0f}\".format(doc.total_received_amount or 0) }}</td>\r\n        </tr>\r\n    </tbody>\r\n</table>\r\n\r\n{# \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\r\n   SECTION 5 \u2014 REMARKS\r\n\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 #}\r\n<table class=\"t-rem\">\r\n    <tr>\r\n        <td class=\"r-lbl\">REMARKS:</td>\r\n        <td class=\"r-val\">\r\n            RECEIVED &#8377; {{ \"{:,.0f}\".format(doc.total_received_amount or 0) }}/- FROM {{ doc.customer }} VIA {{ doc.mode_of_payment or \"N/A\" }} FOR PERIOD {{ frappe.utils.formatdate(doc.from_date, 'dd-MM-yyyy') }} TO {{ frappe.utils.formatdate(doc.to_date, 'dd-MM-yyyy') }}.\r\n        </td>\r\n    </tr>\r\n</table>\r\n\r\n{# \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\r\n   SECTION 6 \u2014 SIGNATURE BLOCK\r\n\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 #}\r\n<table class=\"t-sign\">\r\n    <tr>\r\n        <td style=\"width:33%;\">\r\n            <div class=\"sign-line\">PREPARED BY</div>\r\n        </td>\r\n        <td style=\"width:33%;\">\r\n            <div class=\"sign-line\">CHECKED BY</div>\r\n        </td>\r\n        <td style=\"width:33%;\">\r\n            <div class=\"sign-line\">AUTHORISED SIGNATORY</div>\r\n        </td>\r\n    </tr>\r\n</table>\r\n\r\n{# \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\r\n   FOOTER\r\n\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 #}\r\n<table class=\"t-foot\">\r\n    <tr><td>This is a computer generated receipt \u2014 {{ doc.company }} | {{ doc.name }} | Page 1 of 1</td></tr>\r\n</table>",
