// ══════════════════════════════════════════════════════════════════
//  INJECT STYLES  ← no external CSS file; all styles live here
// ══════════════════════════════════════════════════════════════════

function inject_tms_styles() {
	if (document.getElementById("tms-trip-styles")) return;
	const el = document.createElement("style");
	el.id = "tms-trip-styles";
	el.textContent = `
:root {
  --tms-primary:          #3B4FE4;
  --tms-accent:           #06B6D4;
  --tms-primary-light:    rgba(59,79,228,.10);
  --tms-primary-border:   rgba(59,79,228,.28);
  --tms-label-color:      #3730A3;
  --tms-heading-color:    #1E1B4B;
  --tms-radius:           10px;
}

/* ── Banner ─────────────────────────── */
.tms-trip-banner{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;padding:14px 20px;border-radius:var(--tms-radius) var(--tms-radius) 0 0;position:relative;z-index:2;}
.tms-bid{display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
.tms-bid-icon{font-size:22px;line-height:1;}
.tms-bid-sono{font-size:16px;font-weight:800;color:#fff;letter-spacing:.01em;}
.tms-bid-route{font-size:12px;font-weight:600;color:rgba(255,255,255,.80);background:rgba(255,255,255,.15);border-radius:20px;padding:3px 10px;}
.tms-bprogress{display:flex;align-items:center;gap:10px;}
.tms-dots{display:flex;gap:5px;}
.tms-dot{width:10px;height:10px;border-radius:50%;transition:background .25s,box-shadow .25s;}
.tms-dot-done{background:rgba(255,255,255,.95);box-shadow:0 0 6px rgba(255,255,255,.7);}
.tms-dot-current{background:#fff;box-shadow:0 0 0 3px rgba(255,255,255,.35),0 0 10px rgba(255,255,255,.5);}
.tms-dot-pending{background:rgba(255,255,255,.25);}
.tms-bstage{font-size:11px;font-weight:700;color:rgba(255,255,255,.90);letter-spacing:.05em;text-transform:uppercase;}
.tms-bstatus{display:flex;align-items:center;gap:6px;border:1.5px solid transparent;border-radius:20px;padding:5px 13px;font-size:12px;font-weight:700;letter-spacing:.05em;}
.tms-status-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;}

/* ── Tab badges ─────────────────────── */
.tms-stage-dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--tms-primary);box-shadow:0 0 6px var(--tms-primary);margin-left:5px;vertical-align:middle;animation:tms-pulse 1.6s ease-in-out infinite;}
.tms-tab-check{display:inline-block;margin-left:5px;font-size:11px;color:#10B981;font-weight:800;vertical-align:middle;}
@keyframes tms-pulse{0%,100%{opacity:1;transform:scale(1);}50%{opacity:.55;transform:scale(.8);}}
@keyframes tms-spin{to{transform:rotate(360deg);}}
.tms-sec-icon{font-size:14px;margin-right:4px;}

/* ══════════════════════════════════════
   FIX 1: READONLY FIELD LABEL + VALUE
   Frappe omits <label> for empty readonly
   fields. We inject it and force visibility.
   ══════════════════════════════════════ */
.tms-computed-field{display:block!important;visibility:visible!important;opacity:1!important;position:relative!important;}
.tms-computed-field label.control-label{display:block!important;visibility:visible!important;opacity:1!important;color:var(--tms-label-color)!important;font-size:10px!important;font-weight:700!important;letter-spacing:.07em!important;text-transform:uppercase!important;margin-bottom:4px!important;}
.tms-computed-field .like-disabled-input{display:block!important;visibility:visible!important;opacity:1!important;background:var(--tms-primary-light)!important;border:1.5px solid var(--tms-primary-border)!important;border-radius:calc(var(--tms-radius) - 2px)!important;color:var(--tms-heading-color)!important;font-size:13px!important;font-weight:600!important;padding:7px 10px 7px 32px!important;min-height:36px!important;line-height:1.4!important;cursor:default!important;pointer-events:none!important;box-shadow:inset 0 1px 3px rgba(0,0,0,.04)!important;}
.tms-computed-field input[disabled],.tms-computed-field input[readonly],.tms-computed-field .form-control[disabled]{display:block!important;visibility:visible!important;opacity:1!important;background:var(--tms-primary-light)!important;border:1.5px solid var(--tms-primary-border)!important;border-radius:calc(var(--tms-radius) - 2px)!important;color:var(--tms-heading-color)!important;font-weight:600!important;padding-left:32px!important;min-height:36px!important;pointer-events:none!important;}
.tms-auto-badge{position:absolute!important;left:8px!important;bottom:9px!important;font-size:9px!important;font-weight:700!important;color:var(--tms-primary)!important;opacity:.50!important;pointer-events:none!important;letter-spacing:.04em!important;z-index:3!important;line-height:1!important;}
.tms-stage-locked .like-disabled-input,.tms-stage-locked input[disabled],.tms-stage-locked input[readonly]{background:rgba(251,146,60,.08)!important;border-color:rgba(251,146,60,.30)!important;color:#92400E!important;}

/* ══════════════════════════════════════
   FIX 2: DROPDOWN — no layout shift
   Force awesomplete list to fixed stacking
   context so it floats above the form.
   JS then pins it to exact input coords.
   ══════════════════════════════════════ */
.awesomplete>ul{position:fixed!important;z-index:99999!important;max-height:300px!important;overflow-y:auto!important;overflow-x:hidden!important;border-radius:10px!important;border:1.5px solid var(--tms-primary-border)!important;background:#fff!important;box-shadow:0 8px 32px rgba(0,0,0,.14),0 2px 8px rgba(0,0,0,.07)!important;padding:4px 0!important;scrollbar-width:thin!important;scrollbar-color:var(--tms-primary-border) transparent!important;}
.awesomplete>ul::-webkit-scrollbar{width:5px;}
.awesomplete>ul::-webkit-scrollbar-thumb{background:var(--tms-primary-border);border-radius:4px;}
.awesomplete>ul>li{padding:8px 14px!important;font-size:13px!important;font-weight:500!important;color:var(--tms-heading-color)!important;cursor:pointer!important;transition:background .12s!important;line-height:1.45!important;white-space:normal!important;}
.awesomplete>ul>li:hover,.awesomplete>ul>li[aria-selected="true"]{background:var(--tms-primary-light)!important;color:var(--tms-primary)!important;}
.awesomplete>ul>li mark{background:transparent!important;color:var(--tms-primary)!important;font-weight:800!important;}
.frappe-control[data-fieldtype="Link"],.frappe-control[data-fieldtype="Dynamic Link"]{overflow:visible!important;}
.form-column,.form-section,.section-body{overflow:visible!important;}

/* ── Email template dialog ──────────── */
.etpl-card{border:1.5px solid #E2E8F0;border-radius:12px;overflow:hidden;}
.etpl-head{background:linear-gradient(135deg,var(--tms-primary),#1E1B4B);padding:14px 18px;display:flex;justify-content:space-between;align-items:flex-start;}
.etpl-chip{display:inline-block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:rgba(255,255,255,.7);margin-bottom:4px;}
.etpl-name{font-size:15px;font-weight:800;color:#fff;}
.etpl-open{font-size:11px;font-weight:700;color:rgba(255,255,255,.85);text-decoration:none;background:rgba(255,255,255,.15);border-radius:6px;padding:4px 10px;}
.etpl-open:hover{background:rgba(255,255,255,.25);}
.etpl-copy{font-size:11px;font-weight:700;color:var(--tms-primary);background:var(--tms-primary-light);border:1.5px solid var(--tms-primary-border);border-radius:6px;padding:4px 10px;cursor:pointer;}
.etpl-copy-inv{color:#fff;background:rgba(255,255,255,.15);border-color:rgba(255,255,255,.3);}
.etpl-subject-row{display:flex;align-items:center;gap:10px;padding:10px 18px;background:#F8FAFC;border-bottom:1.5px solid #E2E8F0;}
.etpl-label{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:#94A3B8;white-space:nowrap;}
.etpl-subject-val{flex:1;font-size:13px;font-weight:600;color:#1E293B;}
.etpl-body-header{display:flex;justify-content:space-between;align-items:center;padding:8px 18px 4px;}
.etpl-body{padding:10px 18px 14px;font-size:13px;color:#374151;line-height:1.6;max-height:260px;overflow-y:auto;}
.etpl-footer{font-size:10px;color:#9CA3AF;text-align:right;padding:6px 18px;border-top:1px solid #F1F5F9;font-style:italic;}
.etpl-empty{text-align:center;padding:36px 20px;color:#6B7280;}

`;
	document.head.appendChild(el);
}

// ══════════════════════════════════════════════════════════════════
//  FORM EVENTS
// ══════════════════════════════════════════════════════════════════

frappe.ui.form.on("Trip", {

	refresh(frm) {
		inject_tms_styles();

		frm.$wrapper.off("click.tms_tabs");
		frm._tms_tab_listener_bound = false;

		const combo = get_combo_for_trip(frm.doc.trip_type);
		apply_combo(combo);
		setup_so_no_field(frm);
		setup_field_read_only_rules(frm);
		apply_trip_type_visibility(frm);
		apply_status_locks(frm);
		setup_address_search(frm);
		setup_master_link_filters(frm);
		add_custom_buttons(frm);
		_attach_dropdown_fix(frm);   // ← FIX 2

		setTimeout(() => {
			render_banner(frm, combo);
			render_section_icons(frm);
			run_all_calcs_on_load(frm);
			_force_readonly_fields_visible(frm);
			highlight_active_tab(frm);
		}, 120);
	},

	after_save(frm) {
		_force_readonly_fields_visible(frm);
	},

	onload(frm) {
		inject_tms_styles();
		if (!frm.is_new()) return;

		if (!frm.doc.tcntrip_date)
			frm.set_value("tcntrip_date", frappe.datetime.get_today());

		frappe.call({
			method: "frappe.client.get_list",
			args: { doctype: "Business Format", filters: [["isactive","=",1]], fields: ["name","billing_start_date","billing_end_date"], order_by: "creation asc", limit_page_length: 1 },
			callback(r) {
				if (r.message && r.message.length) {
					frm.set_value("business_format", r.message[0].name);
					_apply_billing_dates_for_current_month(frm, r.message[0]);
				}
			},
		});

		frappe.call({
			method: "frappe.client.get_list",
			args: { doctype: "Trip Type", filters: [["isactive","=",1]], fields: ["name"], order_by: "creation asc", limit_page_length: 1 },
			callback(r) { if (r.message && r.message.length) frm.set_value("trip_type", r.message[0].name); },
		});

		frappe.call({
			method: "logicore.logicore.doctype.trip.trip.get_user_branch",
			callback(r) {
				const res = r.message;
				if (!res) return;
				if (res.branch) {
					frm.set_value("branch", res.branch);
					if (res.source === "single_branch")
						frappe.show_alert({ message: "🏢 Branch auto-set (only one branch exists).", indicator: "blue" }, 4);
				} else if (res.debug) {
					frappe.msgprint({ title: "⚠️ Branch Not Auto-Set", message: res.debug.replace(/\\n/g, "<br>"), indicator: "orange" });
				}
			},
		});

		frappe.call({
			method: "frappe.client.get_list",
			args: { doctype: "Business Subformat", filters: [["isactive","=",1]], fields: ["name"], order_by: "creation asc", limit_page_length: 1 },
			callback(r) { if (r.message && r.message.length) frm.set_value("business_sub_format", r.message[0].name); },
		});
	},

	origin_address_1(frm)      { on_address_selected(frm, "origin_address_1");      },
	origin_address_2(frm)      { on_address_selected(frm, "origin_address_2");      },
	destination_address_1(frm) { on_address_selected(frm, "destination_address_1"); },
	destination_address_2(frm) { on_address_selected(frm, "destination_address_2"); },

	trip_type(frm) {
		preview_so_no_live(frm);
		const combo = get_combo_for_trip(frm.doc.trip_type);
		apply_combo(combo);
		setTimeout(() => render_banner(frm, combo), 50);
		setup_field_read_only_rules(frm);
		apply_trip_type_visibility(frm);
	},

	tcntrip_date(frm) { preview_so_no_live(frm); },

	business_format(frm) {
		if (!frm.doc.business_format) { frm.set_value("billing_start_date",""); frm.set_value("billing_end_date",""); return; }
		frappe.call({
			method: "frappe.client.get",
			args: { doctype: "Business Format", name: frm.doc.business_format },
			callback(r) { if (r.message) _apply_billing_dates_for_current_month(frm, r.message); },
		});
	},

	// FIX: driver mobile — only fetch cell_number (mobile_no is not permitted in query)
	driver(frm) {
		if (!frm.doc.driver) { frm.set_value("driver_mobile", ""); return; }
		frappe.db.get_value("Driver", frm.doc.driver, "cell_number", (r) => {
			if (r && r.cell_number) {
				frm.set_value("driver_mobile", r.cell_number);
			} else {
				frm.set_value("driver_mobile", "");
			}
		});
	},

	origin_city(frm) {
		update_route_chip(frm);
		if (frm.doc.origin_city) {
			frappe.call({
				method: "logicore.logicore.doctype.trip.trip.get_city_state",
				args: { city: frm.doc.origin_city },
				callback(r) { if (r.message) frm.set_value("origin_state", r.message); _force_readonly_fields_visible(frm); },
			});
		} else { _force_readonly_fields_visible(frm); }
		fetch_route_distance(frm);
	},

	destination_city_1(frm) {
		update_route_chip(frm);
		if (frm.doc.destination_city_1) {
			frappe.call({
				method: "logicore.logicore.doctype.trip.trip.get_city_state",
				args: { city: frm.doc.destination_city_1 },
				callback(r) { if (r.message) frm.set_value("destination_state", r.message); _force_readonly_fields_visible(frm); },
			});
		} else { _force_readonly_fields_visible(frm); }
		fetch_route_distance(frm);
	},

	reach_date_time(frm)                { validate_chronology(frm); calc_loading_detention(frm); refresh_calcs(frm); },
	dispatch_date_time(frm)             { validate_chronology(frm); calc_loading_detention(frm); calc_journey_time(frm); refresh_calcs(frm); },
	loading_detention_rate_per_day(frm) { calc_loading_detention_amount(frm); calc_total_detention(frm); calc_total_additional_charges(frm); refresh_calcs(frm); },
	loading_charge(frm)                 { calc_loading_unloading_total(frm); calc_total_additional_charges(frm); refresh_calcs(frm); },

	vendor(frm)      { apply_status_locks(frm); highlight_active_tab(frm); },
	vehicle_no(frm)  { apply_status_locks(frm); highlight_active_tab(frm); },

	arrival_date_time(frm)                { validate_chronology(frm); calc_unloading_detention(frm); calc_journey_time(frm); apply_status_locks(frm); highlight_active_tab(frm); refresh_calcs(frm); },
	release_date_time(frm)                { validate_chronology(frm); calc_unloading_detention(frm); refresh_calcs(frm); },
	unloading_detention_rate_per_day(frm) { calc_unloading_detention_amount(frm); calc_total_detention(frm); calc_total_additional_charges(frm); refresh_calcs(frm); },
	unloading_charge(frm)                 { calc_loading_unloading_total(frm); calc_total_additional_charges(frm); refresh_calcs(frm); },
	weighment_charges(frm)                { calc_total_additional_charges(frm); refresh_calcs(frm); },
	extra_expenses(frm)                   { calc_total_additional_charges(frm); refresh_calcs(frm); },

	distance_loadingunloading_site(frm) { calc_ideal_journey_time(frm); refresh_calcs(frm); },

	start_km(frm)    { validate_km(frm); calc_dedicated_km(frm); refresh_calcs(frm); },
	end_km(frm)      { validate_km(frm); calc_dedicated_km(frm); refresh_calcs(frm); },
	standard_km(frm) { calc_km_variation(frm); refresh_calcs(frm); },

	vendor_freight(frm)            { calc_vendor_freight(frm); refresh_calcs(frm); },
	vendor_freight_extra(frm)      { calc_vendor_freight(frm); refresh_calcs(frm); },
	vendor_tds_to_be_deducted(frm) { calc_vendor_payment_total(frm); refresh_calcs(frm); },
	customer_freight(frm)          { calc_trip_total_amount(frm); refresh_calcs(frm); },

	approved_origin_detention(frm)      { calc_approved_detention(frm); refresh_calcs(frm); },
	approved_destination_detention(frm) { calc_approved_detention(frm); refresh_calcs(frm); },
	approved_loading_charge(frm)        { calc_approved_loading_unloading(frm); refresh_calcs(frm); },
	approved_unloading_charge(frm)      { calc_approved_loading_unloading(frm); refresh_calcs(frm); },
	approved_weighment_charge(frm)      { calc_total_approved_addl(frm); refresh_calcs(frm); },
	approved_extra_expenses(frm)        { calc_total_approved_addl(frm); refresh_calcs(frm); },
	brokerage_amount(frm)               { calc_total_approved_addl(frm); refresh_calcs(frm); },
	lr_money(frm)                       { calc_total_approved_addl(frm); refresh_calcs(frm); },
	tds_deducted_by_customer(frm)       { calc_total_approved_addl(frm); refresh_calcs(frm); },

	date_pod_uploaded_on_erp(frm) {
		frm.set_value("pod_status", frm.doc.date_pod_uploaded_on_erp ? "Uploaded" : "Left");
		update_trip_status_display(frm);
		apply_status_locks(frm);
	},

	utr_no(frm)            { update_trip_status_display(frm); apply_status_locks(frm); highlight_active_tab(frm); },
	payment_advice_no(frm) { update_trip_status_display(frm); apply_status_locks(frm); highlight_active_tab(frm); },
	bill_nodate(frm)       { update_trip_status_display(frm); apply_status_locks(frm); highlight_active_tab(frm); },

	trip_status(frm) {
		const s = frm.doc.trip_status || "Draft";
		const c = STATUS_COLORS[s] || "#94A3B8";
		$(".tms-bstatus").css({ background: hex_alpha(c,.18), color: c, "border-color": hex_alpha(c,.45) });
		$(".tms-status-dot").css({ background: c, "box-shadow": `0 0 6px ${c}` });
		$(".tms-banner-status-text").text(s);
	},
});

// ══════════════════════════════════════════════════════════════════
//  BILLING DATE HELPER
// ══════════════════════════════════════════════════════════════════

function _apply_billing_dates_for_current_month(frm, bf_record) {
	const raw_start = bf_record.billing_start_date;
	const raw_end   = bf_record.billing_end_date;
	if (!raw_start || !raw_end) return;
	const start_day = parseInt(raw_start.split("-")[2], 10);
	const end_day   = parseInt(raw_end.split("-")[2],   10);
	const ref       = new Date((frm.doc.tcntrip_date || frappe.datetime.get_today()) + "T00:00:00");
	const yr        = ref.getFullYear();
	const mon       = ref.getMonth();
	const last_day  = new Date(yr, mon + 1, 0).getDate();
	let bs, be;
	if (end_day >= start_day) {
		bs = new Date(yr, mon, start_day);
		be = new Date(yr, mon, Math.min(end_day, last_day));
	} else {
		bs = new Date(yr, mon - 1, start_day);
		be = new Date(yr, mon, end_day);
	}
	const fmt = d => d.getFullYear() + "-" + String(d.getMonth()+1).padStart(2,"0") + "-" + String(d.getDate()).padStart(2,"0");
	frm.set_value("billing_start_date", fmt(bs));
	frm.set_value("billing_end_date",   fmt(be));
}

// ══════════════════════════════════════════════════════════════════
//  LIVE SO NO PREVIEW
// ══════════════════════════════════════════════════════════════════

function preview_so_no_live(frm) {
	if (!frm.is_new() || !frm.doc.trip_type) return;
	frappe.call({
		method: "logicore.logicore.doctype.trip.trip.preview_so_no",
		args: { trip_type: frm.doc.trip_type, tcntrip_date: frm.doc.tcntrip_date || frappe.datetime.get_today() },
		callback(r) {
			if (r.message) { frm.set_value("so_no", r.message + ""); frm.refresh_field("so_no"); $(".tms-banner-sono").text(r.message); }
		},
	});
}

